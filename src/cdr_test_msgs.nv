        self.count = r.get_i32()
        get_str_64(var r, var self.label)
        get_str_3(var r, var self.tag)
        self.gain = r.get_f64()
        self.enabled = r.get_bool()
        for i in 0..3
            self.trio[i] = r.get_i8()
        let n_seeds = r.get_count(16)
        self.seeds.clear()
        for _ in 0..n_seeds
            let _ = self.seeds.push(r.get_u16())
        self.ratio = r.get_f32()
        self.big = r.get_u64()
        self.neg = r.get_f32()
        self.tiny = r.get_f64()
        let n_none_yet = r.get_count(16)
        self.none_yet.clear()
        for _ in 0..n_none_yet
            let _ = self.none_yet.push(r.get_f64())
        get_str_64(var r, var self.type_)

    // Write the message to `w` and answer the writer's status: `Success`, or the first thing that went wrong.
    fn encode(self, var w: cdr.Writer) -> cdr.Status
        self.write_to(var w)
        w.result()

    // Read the message from `r` into `self` and answer the reader's status.
    fn decode_into(var self, var r: cdr.Reader) -> cdr.Status
        self.read_from(var r)
        r.result()

    // Read a message from `r`, or answer None; the reason is `r.result()`.  The answer is
    // an optional value and not a `Result` because a `Result` that carries a value is a
    // heap cell on a device.
    fn decode(var r: cdr.Reader) -> ?Shapes
        var m = Shapes.new()
        m.read_from(var r)
        if r.ok()
            return Some(m)
        None
