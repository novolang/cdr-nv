// std_srvs/srv/Trigger_Response#full
@test
fn test_vector_std_srvs_Trigger_Response_full() [io, fs]
    let want = vector("std_srvs/srv/Trigger_Response#full")
    var s_1: String[64] = String.new()
    let _ = s_1.push_str("india_1/foxtrot.delta.delta.delta.delta.delta.delta.delta.delta.")
    let m = std_srvs.TriggerResponse {
        success: true,
        message: s_1 }
    // The message built from the values encodes to the middleware's bytes.
    var w = writer_like(want)
