// std_srvs/srv/SetBool_Request
@test
fn test_vector_std_srvs_SetBool_Request() [io, fs]
    let want = vector("std_srvs/srv/SetBool_Request")
    let m = std_srvs.SetBoolRequest {
        data: true }
    // The message built from the values encodes to the middleware's bytes.
    var w = writer_like(want)
    test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
    expect_bytes(hex_of(w), want)
    // The middleware's bytes decode to those values.
    var r = reader_of_hex(want)
    var back = std_srvs.SetBoolRequest.new()
    test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
    test.assert_eq(r.remaining(), (str.len(want) - str.len(hex_of(w))) / 2)
    test.assert_eq(back.data, true)
    // They encode to the same bytes again.
    var w2 = writer_like(want)
    test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
    test.assert_eq_str(hex_of(w2), hex_of(w))
    // The other byte order decodes to the same message, which encodes to the first bytes.
    var wo = writer_unlike(want)
    test.assert_eq_str(cdr.status_name(m.encode(var wo)), "success")
    var ro = cdrbytes.reader_from_bytes(cdrbytes.to_bytes(wo))
    var other = std_srvs.SetBoolRequest.new()
    test.assert_eq_str(cdr.status_name(other.decode_into(var ro)), "success")
    var w3 = writer_like(want)
    test.assert_eq_str(cdr.status_name(other.encode(var w3)), "success")
    test.assert_eq_str(hex_of(w3), hex_of(w))

// std_srvs/srv/SetBool_Response
@test
fn test_vector_std_srvs_SetBool_Response() [io, fs]
    let want = vector("std_srvs/srv/SetBool_Response")
    var s_1: String[64] = String.new()
    let _ = s_1.push_str("echo_1/juliet")
    let m = std_srvs.SetBoolResponse {
        success: true,
        message: s_1 }
    // The message built from the values encodes to the middleware's bytes.
    var w = writer_like(want)
    test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
    expect_bytes(hex_of(w), want)
    // The middleware's bytes decode to those values.
    var r = reader_of_hex(want)
    var back = std_srvs.SetBoolResponse.new()
    test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
    test.assert_eq(r.remaining(), (str.len(want) - str.len(hex_of(w))) / 2)
    test.assert_eq(back.success, true)
    test.assert(back.message.eq_str("echo_1/juliet"))
    // They encode to the same bytes again.
    var w2 = writer_like(want)
    test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
    test.assert_eq_str(hex_of(w2), hex_of(w))
    // The other byte order decodes to the same message, which encodes to the first bytes.
    var wo = writer_unlike(want)
    test.assert_eq_str(cdr.status_name(m.encode(var wo)), "success")
    var ro = cdrbytes.reader_from_bytes(cdrbytes.to_bytes(wo))
    var other = std_srvs.SetBoolResponse.new()
    test.assert_eq_str(cdr.status_name(other.decode_into(var ro)), "success")
    var w3 = writer_like(want)
    test.assert_eq_str(cdr.status_name(other.encode(var w3)), "success")
    test.assert_eq_str(hex_of(w3), hex_of(w))

// std_srvs/srv/SetBool_Response#full
@test
fn test_vector_std_srvs_SetBool_Response_full() [io, fs]
    let want = vector("std_srvs/srv/SetBool_Response#full")
    var s_1: String[64] = String.new()
    let _ = s_1.push_str("echo_1/hotel.india.india.india.india.india.india.india.india.ind")
    let m = std_srvs.SetBoolResponse {
        success: true,
        message: s_1 }
    // The message built from the values encodes to the middleware's bytes.
    var w = writer_like(want)
    test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
    expect_bytes(hex_of(w), want)
    // The middleware's bytes decode to those values.
    var r = reader_of_hex(want)
    var back = std_srvs.SetBoolResponse.new()
    test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
    test.assert_eq(r.remaining(), (str.len(want) - str.len(hex_of(w))) / 2)
    test.assert_eq(back.success, true)
    test.assert(back.message.eq_str("echo_1/hotel.india.india.india.india.india.india.india.india.ind"))
    // They encode to the same bytes again.
    var w2 = writer_like(want)
    test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
    test.assert_eq_str(hex_of(w2), hex_of(w))
    // The other byte order decodes to the same message, which encodes to the first bytes.
    var wo = writer_unlike(want)
    test.assert_eq_str(cdr.status_name(m.encode(var wo)), "success")
    var ro = cdrbytes.reader_from_bytes(cdrbytes.to_bytes(wo))
    var other = std_srvs.SetBoolResponse.new()
    test.assert_eq_str(cdr.status_name(other.decode_into(var ro)), "success")
    var w3 = writer_like(want)
    test.assert_eq_str(cdr.status_name(other.encode(var w3)), "success")
    test.assert_eq_str(hex_of(w3), hex_of(w))

