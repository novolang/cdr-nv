// gen_sensor_msgs_tests.nv — the round trip of every message of sensor_msgs, generated by msggen.
//
// Do not edit this file.  Change msggen or the definitions and generate it again.
//
// Each test encodes the message's `sample()` in little-endian and in big-endian
// CDR, decodes the bytes, encodes the result and compares the two byte strings,
// and checks that the same message with its last byte cut off is refused as
// truncated.

use std.bytes
use std.str
use std.test
use cdr
use cdrbytes
use sensor_msgs

fn writer(le: Bool) -> cdr.Writer
    if le
        cdr.writer_le()
    else
        cdr.writer_be()

fn hex_of(w: cdr.Writer) -> Str
    bytes.to_hex(cdrbytes.to_bytes(w))

// A reader over the writer's bytes with the last `cut` of them removed.
fn reader_of(w: cdr.Writer, cut: Int) -> cdr.Reader
    cdrbytes.reader_from_bytes(bytes.slice(cdrbytes.to_bytes(w), 0, w.len() - cut))

@test
fn test_sensor_msgs_Imu() [io]
    let m = sensor_msgs.Imu.sample()
    let tn = sensor_msgs.Imu.type_name()
    test.assert_eq_str(tn, "sensor_msgs/msg/Imu")
    let dn = sensor_msgs.Imu.dds_type_name()
    test.assert_eq_str(dn, "sensor_msgs::msg::dds_::Imu_")
    test.assert_eq(str.len(sensor_msgs.Imu.type_hash()), 71)
    for le in [true, false]
        var w = writer(le)
        test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
        var r = reader_of(w, 0)
        var back = sensor_msgs.Imu.new()
        test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
        test.assert_eq(r.remaining(), 0)
        var w2 = writer(le)
        test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
        test.assert_eq_str(hex_of(w2), hex_of(w))
        var r2 = reader_of(w, 0)
        match sensor_msgs.Imu.decode(var r2)
            Some(x) =>
                var w3 = writer(le)
                let _ = x.encode(var w3)
                test.assert_eq_str(hex_of(w3), hex_of(w))
            None    => test.fail("a whole message did not decode")
        var r3 = reader_of(w, 1)
        match sensor_msgs.Imu.decode(var r3)
            Some(_) => test.fail("a truncated message decoded")
            None    => test.assert_eq_str(cdr.status_name(r3.result()), "truncated")

@test
fn test_sensor_msgs_NavSatStatus() [io]
    let m = sensor_msgs.NavSatStatus.sample()
    let tn = sensor_msgs.NavSatStatus.type_name()
    test.assert_eq_str(tn, "sensor_msgs/msg/NavSatStatus")
    let dn = sensor_msgs.NavSatStatus.dds_type_name()
    test.assert_eq_str(dn, "sensor_msgs::msg::dds_::NavSatStatus_")
    test.assert_eq(str.len(sensor_msgs.NavSatStatus.type_hash()), 71)
    for le in [true, false]
        var w = writer(le)
        test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
        var r = reader_of(w, 0)
        var back = sensor_msgs.NavSatStatus.new()
        test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
        test.assert_eq(r.remaining(), 0)
        var w2 = writer(le)
        test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
        test.assert_eq_str(hex_of(w2), hex_of(w))
        var r2 = reader_of(w, 0)
        match sensor_msgs.NavSatStatus.decode(var r2)
            Some(x) =>
                var w3 = writer(le)
                let _ = x.encode(var w3)
                test.assert_eq_str(hex_of(w3), hex_of(w))
            None    => test.fail("a whole message did not decode")
        var r3 = reader_of(w, 1)
        match sensor_msgs.NavSatStatus.decode(var r3)
            Some(_) => test.fail("a truncated message decoded")
            None    => test.assert_eq_str(cdr.status_name(r3.result()), "truncated")

@test
fn test_sensor_msgs_Temperature() [io]
    let m = sensor_msgs.Temperature.sample()
    let tn = sensor_msgs.Temperature.type_name()
    test.assert_eq_str(tn, "sensor_msgs/msg/Temperature")
    let dn = sensor_msgs.Temperature.dds_type_name()
    test.assert_eq_str(dn, "sensor_msgs::msg::dds_::Temperature_")
    test.assert_eq(str.len(sensor_msgs.Temperature.type_hash()), 71)
    for le in [true, false]
        var w = writer(le)
        test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
        var r = reader_of(w, 0)
        var back = sensor_msgs.Temperature.new()
        test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
        test.assert_eq(r.remaining(), 0)
        var w2 = writer(le)
        test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
        test.assert_eq_str(hex_of(w2), hex_of(w))
        var r2 = reader_of(w, 0)
        match sensor_msgs.Temperature.decode(var r2)
            Some(x) =>
                var w3 = writer(le)
                let _ = x.encode(var w3)
                test.assert_eq_str(hex_of(w3), hex_of(w))
            None    => test.fail("a whole message did not decode")
        var r3 = reader_of(w, 1)
        match sensor_msgs.Temperature.decode(var r3)
            Some(_) => test.fail("a truncated message decoded")
            None    => test.assert_eq_str(cdr.status_name(r3.result()), "truncated")
