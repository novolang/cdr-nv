    test.assert(back.header.frame_id.eq_str("delta_4/foxtrot.delta.delta.delta.delta.delta.delta.delta.delta."))
    test.assert(back.pose.position.x == -613.1474423269809)
    test.assert(back.pose.position.y == -45.70912738214644)
    test.assert(back.pose.position.z == 832.0381143430291)
