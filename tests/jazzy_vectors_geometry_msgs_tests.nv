// jazzy_vectors_geometry_msgs_tests.nv -- the messages of geometry_msgs as the ROS 2 middleware serialises them.
//
// Do not edit this file.  scripts/rclpy_vectors.py writes it, with tests/jazzy_vectors.tsv.
//
// Each test builds one message from literal values, encodes it and compares the bytes with
// the row of tests/jazzy_vectors.tsv that `rclpy.serialization.serialize_message` produced
// from the same values; decodes the middleware's bytes and checks every field; encodes the
// result again; and sends it through the other byte order and back.  The bytes Fast CDR
// skips to align a value are zero in the vector, because the middleware leaves them as its
// buffer held them; see the header of the TSV.

use std.bytes
use std.fs
use std.str
use std.test
use cdr
use cdrbytes
use builtin_interfaces
use geometry_msgs
use std_msgs

// The hex of the row for `name`.
fn vector(name: Str) -> Str [fs]
    let text = fs.read("tests/jazzy_vectors.tsv") ?? ""
    for line in str.split(text, "\n")
        if not str.starts_with(line, "#")
            let cols = str.split(line, "\t")
            if list.len(cols) == 4 and cols[0] == name
                return cols[3]
    test.fail("no vector for ${name}")
    ""

// A writer in the byte order the vector's header names.
fn writer_like(hex: Str) -> cdr.Writer
    if str.starts_with(hex, "0000")
        cdr.writer_be()
    else
        cdr.writer_le()

// A writer in the other byte order.
fn writer_unlike(hex: Str) -> cdr.Writer
    if str.starts_with(hex, "0000")
        cdr.writer_le()
    else
        cdr.writer_be()

// The writer's bytes are the vector, or the vector without the zero bytes the middleware adds to
// bring a payload of fewer than four bytes up to four.
fn expect_bytes(got: Str, want: Str)
    test.assert(str.len(got) <= str.len(want))
    test.assert_eq_str(str.slice(want, 0, str.len(got)), got)
    let rest = str.slice(want, str.len(got), str.len(want))
    test.assert_eq_str(rest, str.repeat("0", str.len(rest)))
    if str.len(rest) > 0
        test.assert_eq(str.len(want), 16)

fn hex_of(w: cdr.Writer) -> Str
    bytes.to_hex(cdrbytes.to_bytes(w))

fn reader_of_hex(h: Str) -> cdr.Reader
    cdrbytes.reader_from_bytes(bytes.from_hex(h) ?? bytes.zeros(0))

// geometry_msgs/msg/Accel
@test
fn test_vector_geometry_msgs_Accel() [io, fs]
    let want = vector("geometry_msgs/msg/Accel")
    let m = geometry_msgs.Accel {
        linear: geometry_msgs.Vector3 {
            x: 836.97592778335,
            y: 222.36710130391174,
            z: -546.2657973921765 },
        angular: geometry_msgs.Vector3 {
            x: 41.44032096288866,
            y: -904.8335005015045,
            z: 101.29789368104313 } }
    // The message built from the values encodes to the middleware's bytes.
    var w = writer_like(want)
    test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
    expect_bytes(hex_of(w), want)
    // The middleware's bytes decode to those values.
    var r = reader_of_hex(want)
    var back = geometry_msgs.Accel.new()
    test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
    test.assert_eq(r.remaining(), (str.len(want) - str.len(hex_of(w))) / 2)
    test.assert(back.linear.x == 836.97592778335)
    test.assert(back.linear.y == 222.36710130391174)
    test.assert(back.linear.z == -546.2657973921765)
    test.assert(back.angular.x == 41.44032096288866)
    test.assert(back.angular.y == -904.8335005015045)
    test.assert(back.angular.z == 101.29789368104313)
    // They encode to the same bytes again.
    var w2 = writer_like(want)
    test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
    test.assert_eq_str(hex_of(w2), hex_of(w))
    // The other byte order decodes to the same message, which encodes to the first bytes.
    var wo = writer_unlike(want)
    test.assert_eq_str(cdr.status_name(m.encode(var wo)), "success")
    var ro = cdrbytes.reader_from_bytes(cdrbytes.to_bytes(wo))
    var other = geometry_msgs.Accel.new()
    test.assert_eq_str(cdr.status_name(other.decode_into(var ro)), "success")
    var w3 = writer_like(want)
    test.assert_eq_str(cdr.status_name(other.encode(var w3)), "success")
    test.assert_eq_str(hex_of(w3), hex_of(w))

// geometry_msgs/msg/AccelStamped
@test
fn test_vector_geometry_msgs_AccelStamped() [io, fs]
    let want = vector("geometry_msgs/msg/AccelStamped")
    var s_1: String[64] = String.new()
    let _ = s_1.push_str("oscar_4/charli")
    let m = geometry_msgs.AccelStamped {
        header: std_msgs.Header {
            stamp: builtin_interfaces.Time {
                sec: 982166524 as i32,
                nanosec: 2618764225 as u32 },
            frame_id: s_1 },
        accel: geometry_msgs.Accel {
            linear: geometry_msgs.Vector3 {
                x: -183.49448345035105,
                y: 394.00702106318954,
                z: -12.52357071213641 },
            angular: geometry_msgs.Vector3 {
                x: 925.5787362086259,
                y: 682.6158475426279,
                z: 12.752256770310932 } } }
    // The message built from the values encodes to the middleware's bytes.
    var w = writer_like(want)
    test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
    expect_bytes(hex_of(w), want)
    // The middleware's bytes decode to those values.
    var r = reader_of_hex(want)
    var back = geometry_msgs.AccelStamped.new()
    test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
    test.assert_eq(r.remaining(), (str.len(want) - str.len(hex_of(w))) / 2)
    test.assert_eq(back.header.stamp.sec as Int, 982166524)
    test.assert_eq(back.header.stamp.nanosec as Int, 2618764225)
    test.assert(back.header.frame_id.eq_str("oscar_4/charli"))
    test.assert(back.accel.linear.x == -183.49448345035105)
    test.assert(back.accel.linear.y == 394.00702106318954)
    test.assert(back.accel.linear.z == -12.52357071213641)
    test.assert(back.accel.angular.x == 925.5787362086259)
    test.assert(back.accel.angular.y == 682.6158475426279)
    test.assert(back.accel.angular.z == 12.752256770310932)
    // They encode to the same bytes again.
    var w2 = writer_like(want)
    test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
    test.assert_eq_str(hex_of(w2), hex_of(w))
    // The other byte order decodes to the same message, which encodes to the first bytes.
    var wo = writer_unlike(want)
    test.assert_eq_str(cdr.status_name(m.encode(var wo)), "success")
    var ro = cdrbytes.reader_from_bytes(cdrbytes.to_bytes(wo))
    var other = geometry_msgs.AccelStamped.new()
    test.assert_eq_str(cdr.status_name(other.decode_into(var ro)), "success")
    var w3 = writer_like(want)
    test.assert_eq_str(cdr.status_name(other.encode(var w3)), "success")
    test.assert_eq_str(hex_of(w3), hex_of(w))

// geometry_msgs/msg/AccelStamped#full
@test
fn test_vector_geometry_msgs_AccelStamped_full() [io, fs]
    let want = vector("geometry_msgs/msg/AccelStamped#full")
    var s_1: String[64] = String.new()
    let _ = s_1.push_str("oscar_4/delta.kilo.kilo.kilo.kilo.kilo.kilo.kilo.kilo.kilo.kilo.")
    let m = geometry_msgs.AccelStamped {
        header: std_msgs.Header {
            stamp: builtin_interfaces.Time {
                sec: (-696801252) as i32,
                nanosec: 967101368 as u32 },
            frame_id: s_1 },
        accel: geometry_msgs.Accel {
            linear: geometry_msgs.Vector3 {
                x: -318.9478435305918,
                y: -796.5356068204613,
                z: 459.11434302908725 },
            angular: geometry_msgs.Vector3 {
                x: -526.0391173520562,
                y: 184.3901705115346,
                z: -279.7923771313942 } } }
    // The message built from the values encodes to the middleware's bytes.
    var w = writer_like(want)
    test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
    expect_bytes(hex_of(w), want)
    // The middleware's bytes decode to those values.
    var r = reader_of_hex(want)
    var back = geometry_msgs.AccelStamped.new()
    test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
    test.assert_eq(r.remaining(), (str.len(want) - str.len(hex_of(w))) / 2)
    test.assert_eq(back.header.stamp.sec as Int, -696801252)
    test.assert_eq(back.header.stamp.nanosec as Int, 967101368)
    test.assert(back.header.frame_id.eq_str("oscar_4/delta.kilo.kilo.kilo.kilo.kilo.kilo.kilo.kilo.kilo.kilo."))
    test.assert(back.accel.linear.x == -318.9478435305918)
    test.assert(back.accel.linear.y == -796.5356068204613)
    test.assert(back.accel.linear.z == 459.11434302908725)
    test.assert(back.accel.angular.x == -526.0391173520562)
    test.assert(back.accel.angular.y == 184.3901705115346)
    test.assert(back.accel.angular.z == -279.7923771313942)
    // They encode to the same bytes again.
    var w2 = writer_like(want)
    test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
    test.assert_eq_str(hex_of(w2), hex_of(w))
    // The other byte order decodes to the same message, which encodes to the first bytes.
    var wo = writer_unlike(want)
    test.assert_eq_str(cdr.status_name(m.encode(var wo)), "success")
    var ro = cdrbytes.reader_from_bytes(cdrbytes.to_bytes(wo))
    var other = geometry_msgs.AccelStamped.new()
    test.assert_eq_str(cdr.status_name(other.decode_into(var ro)), "success")
    var w3 = writer_like(want)
    test.assert_eq_str(cdr.status_name(other.encode(var w3)), "success")
    test.assert_eq_str(hex_of(w3), hex_of(w))

// geometry_msgs/msg/AccelWithCovariance
@test
fn test_vector_geometry_msgs_AccelWithCovariance() [io, fs]
    let want = vector("geometry_msgs/msg/AccelWithCovariance")
    let m = geometry_msgs.AccelWithCovariance {
        accel: geometry_msgs.Accel {
            linear: geometry_msgs.Vector3 {
                x: -20.831494483450353,
                y: -654.6579739217653,
                z: -735.025075225677 },
            angular: geometry_msgs.Vector3 {
                x: -522.6469408224674,
                y: -665.2577733199598,
                z: 541.7141424272819 } },
        covariance: [-123.26579739217652, 465.5727181544634, -134.37813440320963, -414.1875626880642,
            678.1594784353059, -454.851554663992, -621.0080240722167, 897.4403209628887,
            264.5295887662989, -845.5486459378135, -190.19959879638915, 55.08324974924774,
            -326.5837512537613, 842.8515546639919, -688.7131394182547, 999.8595787362086,
            700.8956870611836, -879.5636910732196, -169.49348044132398, -481.33199598796386,
            911.1414242728184, -73.26680040120361, 289.34503510531596, 282.5195586760281,
            415.1183550651956, -451.70912738214645, 807.036108324975, -776.0300902708125,
            403.0110330992979, 190.0581745235707, 170.7703109327984, 14.52357071213641,
            -117.64393179538615, 736.0330992978937, -566.8575727181544, -711.3981945837512] }
    // The message built from the values encodes to the middleware's bytes.
    var w = writer_like(want)
    test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
    expect_bytes(hex_of(w), want)
    // The middleware's bytes decode to those values.
    var r = reader_of_hex(want)
    var back = geometry_msgs.AccelWithCovariance.new()
    test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
    test.assert_eq(r.remaining(), (str.len(want) - str.len(hex_of(w))) / 2)
    test.assert(back.accel.linear.x == -20.831494483450353)
    test.assert(back.accel.linear.y == -654.6579739217653)
    test.assert(back.accel.linear.z == -735.025075225677)
    test.assert(back.accel.angular.x == -522.6469408224674)
    test.assert(back.accel.angular.y == -665.2577733199598)
    test.assert(back.accel.angular.z == 541.7141424272819)
    test.assert(back.covariance[0] == -123.26579739217652)
    test.assert(back.covariance[1] == 465.5727181544634)
    test.assert(back.covariance[2] == -134.37813440320963)
    test.assert(back.covariance[3] == -414.1875626880642)
    test.assert(back.covariance[4] == 678.1594784353059)
    test.assert(back.covariance[5] == -454.851554663992)
    test.assert(back.covariance[6] == -621.0080240722167)
    test.assert(back.covariance[7] == 897.4403209628887)
    test.assert(back.covariance[8] == 264.5295887662989)
    test.assert(back.covariance[9] == -845.5486459378135)
    test.assert(back.covariance[10] == -190.19959879638915)
    test.assert(back.covariance[11] == 55.08324974924774)
    test.assert(back.covariance[12] == -326.5837512537613)
    test.assert(back.covariance[13] == 842.8515546639919)
    test.assert(back.covariance[14] == -688.7131394182547)
    test.assert(back.covariance[15] == 999.8595787362086)
    test.assert(back.covariance[16] == 700.8956870611836)
    test.assert(back.covariance[17] == -879.5636910732196)
    test.assert(back.covariance[18] == -169.49348044132398)
    test.assert(back.covariance[19] == -481.33199598796386)
    test.assert(back.covariance[20] == 911.1414242728184)
    test.assert(back.covariance[21] == -73.26680040120361)
    test.assert(back.covariance[22] == 289.34503510531596)
    test.assert(back.covariance[23] == 282.5195586760281)
    test.assert(back.covariance[24] == 415.1183550651956)
    test.assert(back.covariance[25] == -451.70912738214645)
    test.assert(back.covariance[26] == 807.036108324975)
    test.assert(back.covariance[27] == -776.0300902708125)
    test.assert(back.covariance[28] == 403.0110330992979)
    test.assert(back.covariance[29] == 190.0581745235707)
    test.assert(back.covariance[30] == 170.7703109327984)
    test.assert(back.covariance[31] == 14.52357071213641)
    test.assert(back.covariance[32] == -117.64393179538615)
    test.assert(back.covariance[33] == 736.0330992978937)
    test.assert(back.covariance[34] == -566.8575727181544)
    test.assert(back.covariance[35] == -711.3981945837512)
    // They encode to the same bytes again.
    var w2 = writer_like(want)
    test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
    test.assert_eq_str(hex_of(w2), hex_of(w))
    // The other byte order decodes to the same message, which encodes to the first bytes.
    var wo = writer_unlike(want)
    test.assert_eq_str(cdr.status_name(m.encode(var wo)), "success")
    var ro = cdrbytes.reader_from_bytes(cdrbytes.to_bytes(wo))
    var other = geometry_msgs.AccelWithCovariance.new()
    test.assert_eq_str(cdr.status_name(other.decode_into(var ro)), "success")
    var w3 = writer_like(want)
    test.assert_eq_str(cdr.status_name(other.encode(var w3)), "success")
    test.assert_eq_str(hex_of(w3), hex_of(w))

// geometry_msgs/msg/AccelWithCovarianceStamped
