// geometry_msgs/msg/PoseArray
@test
fn test_vector_geometry_msgs_PoseArray() [io, fs]
    let want = vector("geometry_msgs/msg/PoseArray")
    var s_1: String[64] = String.new()
    let _ = s_1.push_str("lima_4/bravo")
    var v_2: Vec[Pose; 16] = Vec.new()
    let _ = v_2.push(geometry_msgs.Pose {
            position: geometry_msgs.Point {
                x: 461.5717151454363,
                y: -591.1955867602809,
                z: 591.7141424272819 },
            orientation: geometry_msgs.Quaternion {
                x: -281.7893681043129,
                y: -950.6158475426279,
                z: 241.24172517552657,
                w: -141.59478435305917 } })
    let _ = v_2.push(geometry_msgs.Pose {
            position: geometry_msgs.Point {
                x: -284.2196589769308,
                y: 798.9167502507522,
                z: 26.00902708124373 },
            orientation: geometry_msgs.Quaternion {
                x: 555.987963891675,
                y: -878.9348044132397,
                z: 808.974924774323,
                w: 9.438314944834504 } })
    let m = geometry_msgs.PoseArray {
        header: std_msgs.Header {
            stamp: builtin_interfaces.Time {
                sec: 536844561 as i32,
                nanosec: 259996710 as u32 },
            frame_id: s_1 },
        poses: v_2 }
    // The message built from the values encodes to the middleware's bytes.
    var w = writer_like(want)
    test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
    expect_bytes(hex_of(w), want)
    // The middleware's bytes decode to those values.
    var r = reader_of_hex(want)
    var back = geometry_msgs.PoseArray.new()
    test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
    test.assert_eq(r.remaining(), (str.len(want) - str.len(hex_of(w))) / 2)
    test.assert_eq(back.header.stamp.sec as Int, 536844561)
    test.assert_eq(back.header.stamp.nanosec as Int, 259996710)
    test.assert(back.header.frame_id.eq_str("lima_4/bravo"))
    test.assert_eq(back.poses.len(), 2)
    test.assert(back.poses[0].position.x == 461.5717151454363)
    test.assert(back.poses[0].position.y == -591.1955867602809)
    test.assert(back.poses[0].position.z == 591.7141424272819)
    test.assert(back.poses[0].orientation.x == -281.7893681043129)
    test.assert(back.poses[0].orientation.y == -950.6158475426279)
    test.assert(back.poses[0].orientation.z == 241.24172517552657)
    test.assert(back.poses[0].orientation.w == -141.59478435305917)
    test.assert(back.poses[1].position.x == -284.2196589769308)
    test.assert(back.poses[1].position.y == 798.9167502507522)
    test.assert(back.poses[1].position.z == 26.00902708124373)
    test.assert(back.poses[1].orientation.x == 555.987963891675)
    test.assert(back.poses[1].orientation.y == -878.9348044132397)
    test.assert(back.poses[1].orientation.z == 808.974924774323)
    test.assert(back.poses[1].orientation.w == 9.438314944834504)
    // They encode to the same bytes again.
    var w2 = writer_like(want)
    test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
    test.assert_eq_str(hex_of(w2), hex_of(w))
    // The other byte order decodes to the same message, which encodes to the first bytes.
    var wo = writer_unlike(want)
    test.assert_eq_str(cdr.status_name(m.encode(var wo)), "success")
    var ro = cdrbytes.reader_from_bytes(cdrbytes.to_bytes(wo))
