fn test_vector_geometry_msgs_AccelWithCovarianceStamped() [io, fs]
    let want = vector("geometry_msgs/msg/AccelWithCovarianceStamped")
    var s_1: String[64] = String.new()
    let _ = s_1.push_str("delta_4/foxtr")
    let m = geometry_msgs.AccelWithCovarianceStamped {
        header: std_msgs.Header {
            stamp: builtin_interfaces.Time {
                sec: (-1554476231) as i32,
                nanosec: 673399987 as u32 },
            frame_id: s_1 },
        accel: geometry_msgs.AccelWithCovariance {
            accel: geometry_msgs.Accel {
                linear: geometry_msgs.Vector3 {
                    x: -432.97993981945837,
                    y: 244.6088264794383,
                    z: -592.5275827482448 },
                angular: geometry_msgs.Vector3 {
                    x: -999.8696088264794,
                    y: 66.29187562688064,
                    z: 255.38816449348045 } },
            covariance: [-507.77331995987964, -371.09929789368107, -370.1514543630893, 210.567703109328,
                664.7833500501505, 423.494483450351, 161.99899699097293, 972.9769307923772,
