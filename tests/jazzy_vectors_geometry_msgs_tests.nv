// geometry_msgs/msg/VelocityWithCovarianceStamped#full
@test
fn test_vector_geometry_msgs_VelocityWithCovarianceStamped_full() [io, fs]
    let want = vector("geometry_msgs/msg/VelocityWithCovarianceStamped#full")
    var s_1: String[64] = String.new()
    let _ = s_1.push_str("delta_4/india.kilo.kilo.kilo.kilo.kilo.kilo.kilo.kilo.kilo.kilo.")
    var s_2: String[64] = String.new()
    let _ = s_2.push_str("golf_5/foxtrot.kilo.kilo.kilo.kilo.kilo.kilo.kilo.kilo.kilo.kilo")
    var s_3: String[64] = String.new()
    let _ = s_3.push_str("november_6/alpha.mike.mike.mike.mike.mike.mike.mike.mike.mike.mi")
    let m = geometry_msgs.VelocityWithCovarianceStamped {
        header: std_msgs.Header {
            stamp: builtin_interfaces.Time {
                sec: 1029616009 as i32,
                nanosec: 1535988971 as u32 },
            frame_id: s_1 },
        body_frame_id: s_2,
        reference_frame_id: s_3,
        velocity: geometry_msgs.TwistWithCovariance {
            twist: geometry_msgs.Twist {
                linear: geometry_msgs.Vector3 {
                    x: -391.3249749247743,
                    y: 304.1925777331996,
                    z: -931.9177532597794 },
                angular: geometry_msgs.Vector3 {
                    x: -22.247743229689068,
                    y: 852.9528585757272,
                    z: 923.5947843530591 } },
            covariance: [791.1213640922768, 527.8926780341023, -769.5285857572718, -261.86960882647946,
                -854.6038114343029, -661.1654964894684, -829.2698094282848, -841.7863590772317,
                198.0150451354062, -759.3099297893681, -61.8876629889669, -422.851554663992,
                11.647943831494484, 993.6680040120361, -411.728184553661, 895.8856569709127,
                584.2316950852558, 945.950852557673, -893.9307923771314, -159.7753259779338,
                481.01905717151453, -183.83550651955866, 4.938816449348044, 236.06118355065195,
                -21.106318956870613, 996.6770310932799, -499.21564694082247, 355.8535606820461,
                258.7291875626881, 585.6489468405216, 348.3901705115346, -19.482447342026077,
                407.3009027081244, -956.1715145436309, 325.33299899699097, -478.9709127382146] } }
    // The message built from the values encodes to the middleware's bytes.
    var w = writer_like(want)
    test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
    expect_bytes(hex_of(w), want)
    // The middleware's bytes decode to those values.
    var r = reader_of_hex(want)
    var back = geometry_msgs.VelocityWithCovarianceStamped.new()
    test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
    test.assert_eq(r.remaining(), (str.len(want) - str.len(hex_of(w))) / 2)
    test.assert_eq(back.header.stamp.sec as Int, 1029616009)
    test.assert_eq(back.header.stamp.nanosec as Int, 1535988971)
    test.assert(back.header.frame_id.eq_str("delta_4/india.kilo.kilo.kilo.kilo.kilo.kilo.kilo.kilo.kilo.kilo."))
    test.assert(back.body_frame_id.eq_str("golf_5/foxtrot.kilo.kilo.kilo.kilo.kilo.kilo.kilo.kilo.kilo.kilo"))
    test.assert(back.reference_frame_id.eq_str("november_6/alpha.mike.mike.mike.mike.mike.mike.mike.mike.mike.mi"))
    test.assert(back.velocity.twist.linear.x == -391.3249749247743)
    test.assert(back.velocity.twist.linear.y == 304.1925777331996)
    test.assert(back.velocity.twist.linear.z == -931.9177532597794)
