                y: -374.79839518555667,
                z: -790.950852557673,
                w: 702.8716148445336 } },
        covariance: [-998.1624874623872, 783.4312938816449, -82.88565697091273, -712.1163490471414,
            -873.0320962888666, 918.6429287863591, 732.2547642928787, -231.2938816449348,
