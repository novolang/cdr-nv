// geometry_msgs/msg/AccelWithCovarianceStamped#full
@test
fn test_vector_geometry_msgs_AccelWithCovarianceStamped_full() [io, fs]
    let want = vector("geometry_msgs/msg/AccelWithCovarianceStamped#full")
    var s_1: String[64] = String.new()
    let _ = s_1.push_str("alpha_4/india.alpha.alpha.alpha.alpha.alpha.alpha.alpha.alpha.al")
    let m = geometry_msgs.AccelWithCovarianceStamped {
        header: std_msgs.Header {
            stamp: builtin_interfaces.Time {
                sec: 1280887582 as i32,
                nanosec: 3442992595 as u32 },
            frame_id: s_1 },
        accel: geometry_msgs.AccelWithCovariance {
            accel: geometry_msgs.Accel {
                linear: geometry_msgs.Vector3 {
                    x: 290.8465396188566,
                    y: 576.2016048144434,
                    z: -970.5687061183551 },
                angular: geometry_msgs.Vector3 {
                    x: 305.2637913741224,
                    y: 235.67502507522568,
                    z: -926.6379137412237 } },
            covariance: [-480.28485456369106, -799.0591775325978, 785.480441323972, 564.5867602808426,
                -946.6700100300902, 123.67301905717152, -873.3721163490471, 524.1243731193581,
                228.85155466399198, -825.1193580742226, -631.0882647943831, -536.5566700100301,
                846.1123370110331, -729.6700100300902, 645.0952858575727, 170.2026078234704,
                185.23269809428285, -640.172517552658, 907.3811434302909, 395.3761283851555,
                366.987963891675, -968.6559679037111, -744.3701103309929, -322.59578736208624,
                -862.1524573721164, -153.16248746238716, -175.57071213640924, -603.4583751253762,
                -889.4373119358074, 73.46940822467403, 406.50852557673016, 420.5767301905717,
                884.0922768304915, 965.4603811434303, -527.543630892678, 829.1494483450351] } }
    // The message built from the values encodes to the middleware's bytes.
    var w = writer_like(want)
    test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
    expect_bytes(hex_of(w), want)
    // The middleware's bytes decode to those values.
    var r = reader_of_hex(want)
    var back = geometry_msgs.AccelWithCovarianceStamped.new()
    test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
    test.assert_eq(r.remaining(), (str.len(want) - str.len(hex_of(w))) / 2)
    test.assert_eq(back.header.stamp.sec as Int, 1280887582)
    test.assert_eq(back.header.stamp.nanosec as Int, 3442992595)
    test.assert(back.header.frame_id.eq_str("alpha_4/india.alpha.alpha.alpha.alpha.alpha.alpha.alpha.alpha.al"))
    test.assert(back.accel.accel.linear.x == 290.8465396188566)
    test.assert(back.accel.accel.linear.y == 576.2016048144434)
    test.assert(back.accel.accel.linear.z == -970.5687061183551)
    test.assert(back.accel.accel.angular.x == 305.2637913741224)
    test.assert(back.accel.accel.angular.y == 235.67502507522568)
    test.assert(back.accel.accel.angular.z == -926.6379137412237)
    test.assert(back.accel.covariance[0] == -480.28485456369106)
    test.assert(back.accel.covariance[1] == -799.0591775325978)
    test.assert(back.accel.covariance[2] == 785.480441323972)
    test.assert(back.accel.covariance[3] == 564.5867602808426)
    test.assert(back.accel.covariance[4] == -946.6700100300902)
    test.assert(back.accel.covariance[5] == 123.67301905717152)
    test.assert(back.accel.covariance[6] == -873.3721163490471)
    test.assert(back.accel.covariance[7] == 524.1243731193581)
    test.assert(back.accel.covariance[8] == 228.85155466399198)
    test.assert(back.accel.covariance[9] == -825.1193580742226)
    test.assert(back.accel.covariance[10] == -631.0882647943831)
    test.assert(back.accel.covariance[11] == -536.5566700100301)
    test.assert(back.accel.covariance[12] == 846.1123370110331)
    test.assert(back.accel.covariance[13] == -729.6700100300902)
    test.assert(back.accel.covariance[14] == 645.0952858575727)
    test.assert(back.accel.covariance[15] == 170.2026078234704)
    test.assert(back.accel.covariance[16] == 185.23269809428285)
    test.assert(back.accel.covariance[17] == -640.172517552658)
    test.assert(back.accel.covariance[18] == 907.3811434302909)
    test.assert(back.accel.covariance[19] == 395.3761283851555)
    test.assert(back.accel.covariance[20] == 366.987963891675)
    test.assert(back.accel.covariance[21] == -968.6559679037111)
    test.assert(back.accel.covariance[22] == -744.3701103309929)
    test.assert(back.accel.covariance[23] == -322.59578736208624)
    test.assert(back.accel.covariance[24] == -862.1524573721164)
    test.assert(back.accel.covariance[25] == -153.16248746238716)
    test.assert(back.accel.covariance[26] == -175.57071213640924)
    test.assert(back.accel.covariance[27] == -603.4583751253762)
    test.assert(back.accel.covariance[28] == -889.4373119358074)
    test.assert(back.accel.covariance[29] == 73.46940822467403)
    test.assert(back.accel.covariance[30] == 406.50852557673016)
    test.assert(back.accel.covariance[31] == 420.5767301905717)
    test.assert(back.accel.covariance[32] == 884.0922768304915)
    test.assert(back.accel.covariance[33] == 965.4603811434303)
    test.assert(back.accel.covariance[34] == -527.543630892678)
    test.assert(back.accel.covariance[35] == 829.1494483450351)
    // They encode to the same bytes again.
    var w2 = writer_like(want)
    test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
    test.assert_eq_str(hex_of(w2), hex_of(w))
    // The other byte order decodes to the same message, which encodes to the first bytes.
    var wo = writer_unlike(want)
    test.assert_eq_str(cdr.status_name(m.encode(var wo)), "success")
    var ro = cdrbytes.reader_from_bytes(cdrbytes.to_bytes(wo))
    var other = geometry_msgs.AccelWithCovarianceStamped.new()
    test.assert_eq_str(cdr.status_name(other.decode_into(var ro)), "success")
    var w3 = writer_like(want)
    test.assert_eq_str(cdr.status_name(other.encode(var w3)), "success")
    test.assert_eq_str(hex_of(w3), hex_of(w))

