// gen_builtin_interfaces_tests.nv — the round trip of every message of builtin_interfaces, generated by msggen.
//
// Do not edit this file.  Change msggen or the definitions and generate it again.
//
// Each test encodes the message's `sample()` in little-endian and in big-endian
// CDR, decodes the bytes, encodes the result and compares the two byte strings,
// and checks that the same message with its last byte cut off is refused as
// truncated.

use std.bytes
use std.str
use std.test
use cdr
use cdrbytes
use builtin_interfaces

fn writer(le: Bool) -> cdr.Writer
    if le
        cdr.writer_le()
    else
        cdr.writer_be()

fn hex_of(w: cdr.Writer) -> Str
    bytes.to_hex(cdrbytes.to_bytes(w))

// A reader over the writer's bytes with the last `cut` of them removed.
fn reader_of(w: cdr.Writer, cut: Int) -> cdr.Reader
    cdrbytes.reader_from_bytes(bytes.slice(cdrbytes.to_bytes(w), 0, w.len() - cut))

@test
fn test_builtin_interfaces_Duration() [io]
    let m = builtin_interfaces.DurationMsg.sample()
    let tn = builtin_interfaces.DurationMsg.type_name()
    test.assert_eq_str(tn, "builtin_interfaces/msg/Duration")
    let dn = builtin_interfaces.DurationMsg.dds_type_name()
    test.assert_eq_str(dn, "builtin_interfaces::msg::dds_::Duration_")
    test.assert_eq(str.len(builtin_interfaces.DurationMsg.type_hash()), 71)
    for le in [true, false]
        var w = writer(le)
        test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
        var r = reader_of(w, 0)
        var back = builtin_interfaces.DurationMsg.new()
        test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
        test.assert_eq(r.remaining(), 0)
        var w2 = writer(le)
        test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
        test.assert_eq_str(hex_of(w2), hex_of(w))
        var r2 = reader_of(w, 0)
        match builtin_interfaces.DurationMsg.decode(var r2)
            Some(x) =>
                var w3 = writer(le)
                let _ = x.encode(var w3)
                test.assert_eq_str(hex_of(w3), hex_of(w))
            None    => test.fail("a whole message did not decode")
        var r3 = reader_of(w, 1)
        match builtin_interfaces.DurationMsg.decode(var r3)
            Some(_) => test.fail("a truncated message decoded")
            None    => test.assert_eq_str(cdr.status_name(r3.result()), "truncated")

@test
fn test_builtin_interfaces_Time() [io]
    let m = builtin_interfaces.Time.sample()
    let tn = builtin_interfaces.Time.type_name()
    test.assert_eq_str(tn, "builtin_interfaces/msg/Time")
    let dn = builtin_interfaces.Time.dds_type_name()
    test.assert_eq_str(dn, "builtin_interfaces::msg::dds_::Time_")
    test.assert_eq(str.len(builtin_interfaces.Time.type_hash()), 71)
    for le in [true, false]
        var w = writer(le)
        test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
        var r = reader_of(w, 0)
        var back = builtin_interfaces.Time.new()
        test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
        test.assert_eq(r.remaining(), 0)
        var w2 = writer(le)
        test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
        test.assert_eq_str(hex_of(w2), hex_of(w))
        var r2 = reader_of(w, 0)
        match builtin_interfaces.Time.decode(var r2)
            Some(x) =>
                var w3 = writer(le)
                let _ = x.encode(var w3)
                test.assert_eq_str(hex_of(w3), hex_of(w))
            None    => test.fail("a whole message did not decode")
        var r3 = reader_of(w, 1)
        match builtin_interfaces.Time.decode(var r3)
            Some(_) => test.fail("a truncated message decoded")
            None    => test.assert_eq_str(cdr.status_name(r3.result()), "truncated")
