// jazzy_vectors_rcl_interfaces_tests.nv -- the messages of rcl_interfaces as the ROS 2 middleware serialises them.
//
// Do not edit this file.  scripts/rclpy_vectors.py writes it, with tests/jazzy_vectors.tsv.
//
// Each test builds one message from literal values, encodes it and compares the bytes with
// the row of tests/jazzy_vectors.tsv that `rclpy.serialization.serialize_message` produced
// from the same values; decodes the middleware's bytes and checks every field; encodes the
// result again; and sends it through the other byte order and back.  The bytes Fast CDR
// skips to align a value are zero in the vector, because the middleware leaves them as its
// buffer held them; see the header of the TSV.

use std.bytes
use std.fs
use std.str
use std.test
use cdr
use cdrbytes
use builtin_interfaces
use rcl_interfaces

// The hex of the row for `name`.
fn vector(name: Str) -> Str [fs]
    let text = fs.read("tests/jazzy_vectors.tsv") ?? ""
    for line in str.split(text, "\n")
        if not str.starts_with(line, "#")
            let cols = str.split(line, "\t")
            if list.len(cols) == 4 and cols[0] == name
                return cols[3]
    test.fail("no vector for ${name}")
    ""

// A writer in the byte order the vector's header names.
fn writer_like(hex: Str) -> cdr.Writer
    if str.starts_with(hex, "0000")
        cdr.writer_be()
    else
        cdr.writer_le()

// A writer in the other byte order.
fn writer_unlike(hex: Str) -> cdr.Writer
    if str.starts_with(hex, "0000")
        cdr.writer_le()
    else
        cdr.writer_be()

// The writer's bytes are the vector, or the vector without the zero bytes the middleware adds to
// bring a payload of fewer than four bytes up to four.
fn expect_bytes(got: Str, want: Str)
    test.assert(str.len(got) <= str.len(want))
    test.assert_eq_str(str.slice(want, 0, str.len(got)), got)
    let rest = str.slice(want, str.len(got), str.len(want))
    test.assert_eq_str(rest, str.repeat("0", str.len(rest)))
    if str.len(rest) > 0
        test.assert_eq(str.len(want), 16)

fn hex_of(w: cdr.Writer) -> Str
    bytes.to_hex(cdrbytes.to_bytes(w))

fn reader_of_hex(h: Str) -> cdr.Reader
    cdrbytes.reader_from_bytes(bytes.from_hex(h) ?? bytes.zeros(0))

// rcl_interfaces/msg/FloatingPointRange
@test
fn test_vector_rcl_interfaces_FloatingPointRange() [io, fs]
    let want = vector("rcl_interfaces/msg/FloatingPointRange")
    let m = rcl_interfaces.FloatingPointRange {
        from_value: -513.1955867602809,
        to_value: 990.3691073219659,
        step: 738.3480441323971 }
    // The message built from the values encodes to the middleware's bytes.
    var w = writer_like(want)
    test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
    expect_bytes(hex_of(w), want)
    // The middleware's bytes decode to those values.
    var r = reader_of_hex(want)
    var back = rcl_interfaces.FloatingPointRange.new()
    test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
    test.assert_eq(r.remaining(), (str.len(want) - str.len(hex_of(w))) / 2)
    test.assert(back.from_value == -513.1955867602809)
    test.assert(back.to_value == 990.3691073219659)
    test.assert(back.step == 738.3480441323971)
    // They encode to the same bytes again.
    var w2 = writer_like(want)
    test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
    test.assert_eq_str(hex_of(w2), hex_of(w))
    // The other byte order decodes to the same message, which encodes to the first bytes.
    var wo = writer_unlike(want)
    test.assert_eq_str(cdr.status_name(m.encode(var wo)), "success")
    var ro = cdrbytes.reader_from_bytes(cdrbytes.to_bytes(wo))
    var other = rcl_interfaces.FloatingPointRange.new()
    test.assert_eq_str(cdr.status_name(other.decode_into(var ro)), "success")
    var w3 = writer_like(want)
    test.assert_eq_str(cdr.status_name(other.encode(var w3)), "success")
    test.assert_eq_str(hex_of(w3), hex_of(w))

// rcl_interfaces/msg/IntegerRange
@test
fn test_vector_rcl_interfaces_IntegerRange() [io, fs]
    let want = vector("rcl_interfaces/msg/IntegerRange")
    let m = rcl_interfaces.IntegerRange {
        from_value: 3782795778144884395,
        to_value: -9223371771353890498,
        step: 89 }
    // The message built from the values encodes to the middleware's bytes.
    var w = writer_like(want)
    test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
    expect_bytes(hex_of(w), want)
    // The middleware's bytes decode to those values.
    var r = reader_of_hex(want)
    var back = rcl_interfaces.IntegerRange.new()
    test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
    test.assert_eq(r.remaining(), (str.len(want) - str.len(hex_of(w))) / 2)
    test.assert_eq(back.from_value, 3782795778144884395)
    test.assert_eq(back.to_value, -9223371771353890498)
    test.assert_eq(back.step, 89)
    // They encode to the same bytes again.
    var w2 = writer_like(want)
    test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
    test.assert_eq_str(hex_of(w2), hex_of(w))
    // The other byte order decodes to the same message, which encodes to the first bytes.
    var wo = writer_unlike(want)
    test.assert_eq_str(cdr.status_name(m.encode(var wo)), "success")
    var ro = cdrbytes.reader_from_bytes(cdrbytes.to_bytes(wo))
    var other = rcl_interfaces.IntegerRange.new()
    test.assert_eq_str(cdr.status_name(other.decode_into(var ro)), "success")
    var w3 = writer_like(want)
    test.assert_eq_str(cdr.status_name(other.encode(var w3)), "success")
    test.assert_eq_str(hex_of(w3), hex_of(w))

// rcl_interfaces/msg/ListParametersResult
@test
fn test_vector_rcl_interfaces_ListParametersResult() [io, fs]
    let want = vector("rcl_interfaces/msg/ListParametersResult")
    var v_1: Vec[String[32]; 4] = Vec.new()
    var s_2: String[32] = String.new()
    let _ = s_2.push_str("kilo_1/alpha")
    let _ = v_1.push(s_2)
    var s_3: String[32] = String.new()
    let _ = s_3.push_str("bravo_2/kilo")
    let _ = v_1.push(s_3)
    var s_4: String[32] = String.new()
    let _ = s_4.push_str("mike_3/bravo")
    let _ = v_1.push(s_4)
    var v_5: Vec[String[32]; 4] = Vec.new()
    var s_6: String[32] = String.new()
    let _ = s_6.push_str("lima_4/juliet")
    let _ = v_5.push(s_6)
    var s_7: String[32] = String.new()
    let _ = s_7.push_str("oscar_5/echo")
    let _ = v_5.push(s_7)
    var s_8: String[32] = String.new()
    let _ = s_8.push_str("foxtrot_6/echo")
    let _ = v_5.push(s_8)
    let m = rcl_interfaces.ListParametersResult {
        names: v_1,
        prefixes: v_5 }
    // The message built from the values encodes to the middleware's bytes.
    var w = writer_like(want)
    test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
    expect_bytes(hex_of(w), want)
    // The middleware's bytes decode to those values.
    var r = reader_of_hex(want)
    var back = rcl_interfaces.ListParametersResult.new()
    test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
    test.assert_eq(r.remaining(), (str.len(want) - str.len(hex_of(w))) / 2)
    test.assert_eq(back.names.len(), 3)
    test.assert(back.names[0].eq_str("kilo_1/alpha"))
    test.assert(back.names[1].eq_str("bravo_2/kilo"))
    test.assert(back.names[2].eq_str("mike_3/bravo"))
    test.assert_eq(back.prefixes.len(), 3)
    test.assert(back.prefixes[0].eq_str("lima_4/juliet"))
    test.assert(back.prefixes[1].eq_str("oscar_5/echo"))
    test.assert(back.prefixes[2].eq_str("foxtrot_6/echo"))
    // They encode to the same bytes again.
    var w2 = writer_like(want)
    test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
    test.assert_eq_str(hex_of(w2), hex_of(w))
    // The other byte order decodes to the same message, which encodes to the first bytes.
    var wo = writer_unlike(want)
    test.assert_eq_str(cdr.status_name(m.encode(var wo)), "success")
    var ro = cdrbytes.reader_from_bytes(cdrbytes.to_bytes(wo))
    var other = rcl_interfaces.ListParametersResult.new()
    test.assert_eq_str(cdr.status_name(other.decode_into(var ro)), "success")
    var w3 = writer_like(want)
    test.assert_eq_str(cdr.status_name(other.encode(var w3)), "success")
    test.assert_eq_str(hex_of(w3), hex_of(w))

// rcl_interfaces/msg/ListParametersResult#full
@test
fn test_vector_rcl_interfaces_ListParametersResult_full() [io, fs]
    let want = vector("rcl_interfaces/msg/ListParametersResult#full")
    var v_1: Vec[String[32]; 4] = Vec.new()
    var s_2: String[32] = String.new()
    let _ = s_2.push_str("lima_1/foxtrot.delta.delta.delta")
    let _ = v_1.push(s_2)
    var s_3: String[32] = String.new()
    let _ = s_3.push_str("oscar_2/juliet.foxtrot.foxtrot.f")
    let _ = v_1.push(s_3)
    var s_4: String[32] = String.new()
    let _ = s_4.push_str("foxtrot_3/bravo.charlie.charlie.")
    let _ = v_1.push(s_4)
    var s_5: String[32] = String.new()
    let _ = s_5.push_str("alpha_4/alpha.echo.echo.echo.ech")
    let _ = v_1.push(s_5)
    var v_6: Vec[String[32]; 4] = Vec.new()
    var s_7: String[32] = String.new()
    let _ = s_7.push_str("papa_5/golf.juliet.juliet.juliet")
    let _ = v_6.push(s_7)
    var s_8: String[32] = String.new()
    let _ = s_8.push_str("charlie_6/delta.hotel.hotel.hote")
    let _ = v_6.push(s_8)
    var s_9: String[32] = String.new()
    let _ = s_9.push_str("juliet_7/mike.charlie.charlie.ch")
    let _ = v_6.push(s_9)
    var s_10: String[32] = String.new()
    let _ = s_10.push_str("echo_8/hotel.hotel.hotel.hotel.h")
    let _ = v_6.push(s_10)
    let m = rcl_interfaces.ListParametersResult {
        names: v_1,
        prefixes: v_6 }
    // The message built from the values encodes to the middleware's bytes.
    var w = writer_like(want)
    test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
    expect_bytes(hex_of(w), want)
    // The middleware's bytes decode to those values.
    var r = reader_of_hex(want)
    var back = rcl_interfaces.ListParametersResult.new()
    test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
    test.assert_eq(r.remaining(), (str.len(want) - str.len(hex_of(w))) / 2)
    test.assert_eq(back.names.len(), 4)
    test.assert(back.names[0].eq_str("lima_1/foxtrot.delta.delta.delta"))
    test.assert(back.names[1].eq_str("oscar_2/juliet.foxtrot.foxtrot.f"))
    test.assert(back.names[2].eq_str("foxtrot_3/bravo.charlie.charlie."))
    test.assert(back.names[3].eq_str("alpha_4/alpha.echo.echo.echo.ech"))
    test.assert_eq(back.prefixes.len(), 4)
    test.assert(back.prefixes[0].eq_str("papa_5/golf.juliet.juliet.juliet"))
    test.assert(back.prefixes[1].eq_str("charlie_6/delta.hotel.hotel.hote"))
    test.assert(back.prefixes[2].eq_str("juliet_7/mike.charlie.charlie.ch"))
    test.assert(back.prefixes[3].eq_str("echo_8/hotel.hotel.hotel.hotel.h"))
    // They encode to the same bytes again.
    var w2 = writer_like(want)
    test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
    test.assert_eq_str(hex_of(w2), hex_of(w))
    // The other byte order decodes to the same message, which encodes to the first bytes.
    var wo = writer_unlike(want)
    test.assert_eq_str(cdr.status_name(m.encode(var wo)), "success")
    var ro = cdrbytes.reader_from_bytes(cdrbytes.to_bytes(wo))
    var other = rcl_interfaces.ListParametersResult.new()
    test.assert_eq_str(cdr.status_name(other.decode_into(var ro)), "success")
    var w3 = writer_like(want)
    test.assert_eq_str(cdr.status_name(other.encode(var w3)), "success")
    test.assert_eq_str(hex_of(w3), hex_of(w))

// rcl_interfaces/msg/Log
@test
fn test_vector_rcl_interfaces_Log() [io, fs]
    let want = vector("rcl_interfaces/msg/Log")
    var s_1: String[32] = String.new()
    let _ = s_1.push_str("echo_5/golf")
    var s_2: String[32] = String.new()
    let _ = s_2.push_str("delta_6/novembe")
    var s_3: String[32] = String.new()
    let _ = s_3.push_str("golf_7/golf")
    var s_4: String[32] = String.new()
    let _ = s_4.push_str("november_8/november")
    let m = rcl_interfaces.Log {
        stamp: builtin_interfaces.Time {
            sec: 1062380031 as i32,
            nanosec: 331829938 as u32 },
        level: 42 as u8,
        name: s_1,
        msg: s_2,
        file: s_3,
        function: s_4,
        line: 351748487 as u32 }
    // The message built from the values encodes to the middleware's bytes.
    var w = writer_like(want)
    test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
    expect_bytes(hex_of(w), want)
    // The middleware's bytes decode to those values.
    var r = reader_of_hex(want)
    var back = rcl_interfaces.Log.new()
    test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
    test.assert_eq(r.remaining(), (str.len(want) - str.len(hex_of(w))) / 2)
    test.assert_eq(back.stamp.sec as Int, 1062380031)
    test.assert_eq(back.stamp.nanosec as Int, 331829938)
    test.assert_eq(back.level as Int, 42)
    test.assert(back.name.eq_str("echo_5/golf"))
    test.assert(back.msg.eq_str("delta_6/novembe"))
    test.assert(back.file.eq_str("golf_7/golf"))
    test.assert(back.function.eq_str("november_8/november"))
    test.assert_eq(back.line as Int, 351748487)
    // They encode to the same bytes again.
    var w2 = writer_like(want)
    test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
    test.assert_eq_str(hex_of(w2), hex_of(w))
    // The other byte order decodes to the same message, which encodes to the first bytes.
    var wo = writer_unlike(want)
    test.assert_eq_str(cdr.status_name(m.encode(var wo)), "success")
    var ro = cdrbytes.reader_from_bytes(cdrbytes.to_bytes(wo))
    var other = rcl_interfaces.Log.new()
    test.assert_eq_str(cdr.status_name(other.decode_into(var ro)), "success")
    var w3 = writer_like(want)
    test.assert_eq_str(cdr.status_name(other.encode(var w3)), "success")
    test.assert_eq_str(hex_of(w3), hex_of(w))

// rcl_interfaces/msg/Log#full
@test
fn test_vector_rcl_interfaces_Log_full() [io, fs]
    let want = vector("rcl_interfaces/msg/Log#full")
    var s_1: String[32] = String.new()
    let _ = s_1.push_str("papa_5/juliet.delta.delta.delta.")
    var s_2: String[32] = String.new()
    let _ = s_2.push_str("charlie_6/foxtrot.juliet.juliet.")
    var s_3: String[32] = String.new()
    let _ = s_3.push_str("juliet_7/hotel.mike.mike.mike.mi")
    var s_4: String[32] = String.new()
    let _ = s_4.push_str("echo_8/oscar.juliet.juliet.julie")
    let m = rcl_interfaces.Log {
        stamp: builtin_interfaces.Time {
            sec: 1708493182 as i32,
            nanosec: 1562559850 as u32 },
        level: 81 as u8,
        name: s_1,
        msg: s_2,
        file: s_3,
        function: s_4,
        line: 80615654 as u32 }
    // The message built from the values encodes to the middleware's bytes.
    var w = writer_like(want)
    test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
    expect_bytes(hex_of(w), want)
    // The middleware's bytes decode to those values.
    var r = reader_of_hex(want)
    var back = rcl_interfaces.Log.new()
    test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
    test.assert_eq(r.remaining(), (str.len(want) - str.len(hex_of(w))) / 2)
    test.assert_eq(back.stamp.sec as Int, 1708493182)
    test.assert_eq(back.stamp.nanosec as Int, 1562559850)
    test.assert_eq(back.level as Int, 81)
    test.assert(back.name.eq_str("papa_5/juliet.delta.delta.delta."))
    test.assert(back.msg.eq_str("charlie_6/foxtrot.juliet.juliet."))
    test.assert(back.file.eq_str("juliet_7/hotel.mike.mike.mike.mi"))
    test.assert(back.function.eq_str("echo_8/oscar.juliet.juliet.julie"))
    test.assert_eq(back.line as Int, 80615654)
    // They encode to the same bytes again.
    var w2 = writer_like(want)
    test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
    test.assert_eq_str(hex_of(w2), hex_of(w))
    // The other byte order decodes to the same message, which encodes to the first bytes.
    var wo = writer_unlike(want)
    test.assert_eq_str(cdr.status_name(m.encode(var wo)), "success")
    var ro = cdrbytes.reader_from_bytes(cdrbytes.to_bytes(wo))
    var other = rcl_interfaces.Log.new()
    test.assert_eq_str(cdr.status_name(other.decode_into(var ro)), "success")
    var w3 = writer_like(want)
    test.assert_eq_str(cdr.status_name(other.encode(var w3)), "success")
    test.assert_eq_str(hex_of(w3), hex_of(w))

