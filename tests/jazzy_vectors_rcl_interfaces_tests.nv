    test.assert(back.floating_point_range[0].to_value == -117.08726178535606)
    test.assert(back.floating_point_range[0].step == -674.9518555667001)
    test.assert_eq(back.integer_range.len(), 1)
    test.assert_eq(back.integer_range[0].from_value, 95)
    test.assert_eq(back.integer_range[0].to_value, -3455387393792269691)
    test.assert_eq(back.integer_range[0].step, 208361231152)
    // They encode to the same bytes again.
