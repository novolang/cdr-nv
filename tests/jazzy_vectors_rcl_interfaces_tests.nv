// rcl_interfaces/msg/Parameter
@test
fn test_vector_rcl_interfaces_Parameter() [io, fs]
    let want = vector("rcl_interfaces/msg/Parameter")
    var s_1: String[32] = String.new()
    let _ = s_1.push_str("echo_1/alpha")
    var s_2: String[32] = String.new()
    let _ = s_2.push_str("india_5/mike")
    var v_3: Vec[u8; 4] = Vec.new()
    let _ = v_3.push(254 as u8)
    let _ = v_3.push(186 as u8)
    let _ = v_3.push(86 as u8)
    var v_4: Vec[Bool; 4] = Vec.new()
