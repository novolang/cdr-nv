    let _ = s_3.push_str("delta_3/delt")
    var s_4: String[32] = String.new()
    let _ = s_4.push_str("golf_4/papa")
    var v_5: Vec[FloatingPointRange; 1] = Vec.new()
    let _ = v_5.push(rcl_interfaces.FloatingPointRange {
            from_value: -261.8876629889669,
            to_value: -257.5646940822467,
            step: 485.52657973921765 })
    var v_6: Vec[IntegerRange; 1] = Vec.new()
    let _ = v_6.push(rcl_interfaces.IntegerRange {
            from_value: 31,
            to_value: 5575209986600376477,
            step: 748647304110 })
    let _ = v_1.push(rcl_interfaces.ParameterDescriptor {
            name: s_2,
            type_: 255 as u8,
            description: s_3,
            additional_constraints: s_4,
            read_only: true,
            dynamic_typing: true,
            floating_point_range: v_5,
            integer_range: v_6 })
    var s_7: String[32] = String.new()
