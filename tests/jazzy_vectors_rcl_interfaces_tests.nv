    var back = rcl_interfaces.DescribeParametersResponse.new()
    test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
    test.assert_eq(r.remaining(), (str.len(want) - str.len(hex_of(w))) / 2)
    test.assert_eq(back.descriptors.len(), 2)
    test.assert(back.descriptors[0].name.eq_str("juliet_1/lima"))
    test.assert_eq(back.descriptors[0].type_ as Int, 255)
    test.assert(back.descriptors[0].description.eq_str("delta_3/delt"))
    test.assert(back.descriptors[0].additional_constraints.eq_str("golf_4/papa"))
    test.assert_eq(back.descriptors[0].read_only, true)
    test.assert_eq(back.descriptors[0].dynamic_typing, true)
    test.assert_eq(back.descriptors[0].floating_point_range.len(), 1)
    test.assert(back.descriptors[0].floating_point_range[0].from_value == -261.8876629889669)
    test.assert(back.descriptors[0].floating_point_range[0].to_value == -257.5646940822467)
    test.assert(back.descriptors[0].floating_point_range[0].step == 485.52657973921765)
    test.assert_eq(back.descriptors[0].integer_range.len(), 1)
