    test.assert_eq(back.descriptors[0].integer_range[0].step, 748647304110)
    test.assert(back.descriptors[1].name.eq_str("oscar_12/india"))
    test.assert_eq(back.descriptors[1].type_ as Int, 144)
    test.assert(back.descriptors[1].description.eq_str("papa_15/foxtrot"))
    test.assert(back.descriptors[1].additional_constraints.eq_str("charlie_16/hotel"))
