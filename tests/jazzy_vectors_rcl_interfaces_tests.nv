    test.assert(back.changed_parameters[0].value.string_array_value[3].eq_str("charlie_59/g"))
    test.assert_eq(back.deleted_parameters.len(), 1)
    test.assert(back.deleted_parameters[0].name.eq_str("juliet_60/ind"))
    test.assert_eq(back.deleted_parameters[0].value.type_ as Int, 115)
    test.assert_eq(back.deleted_parameters[0].value.bool_value, true)
    test.assert_eq(back.deleted_parameters[0].value.integer_value, -9223371880459192795)
    test.assert(back.deleted_parameters[0].value.double_value == -532.6148445336008)
    test.assert(back.deleted_parameters[0].value.string_value.eq_str("india_65/delt"))
    test.assert_eq(back.deleted_parameters[0].value.byte_array_value.len(), 4)
    test.assert_eq(back.deleted_parameters[0].value.byte_array_value[0] as Int, 253)
    test.assert_eq(back.deleted_parameters[0].value.byte_array_value[1] as Int, 9)
    test.assert_eq(back.deleted_parameters[0].value.byte_array_value[2] as Int, 94)
    test.assert_eq(back.deleted_parameters[0].value.byte_array_value[3] as Int, 123)
    test.assert_eq(back.deleted_parameters[0].value.bool_array_value.len(), 4)
    test.assert_eq(back.deleted_parameters[0].value.bool_array_value[0], false)
    test.assert_eq(back.deleted_parameters[0].value.bool_array_value[1], true)
    test.assert_eq(back.deleted_parameters[0].value.bool_array_value[2], true)
    test.assert_eq(back.deleted_parameters[0].value.bool_array_value[3], true)
    test.assert_eq(back.deleted_parameters[0].value.integer_array_value.len(), 4)
    test.assert_eq(back.deleted_parameters[0].value.integer_array_value[0], -9223370994507599117)
    test.assert_eq(back.deleted_parameters[0].value.integer_array_value[1], -14)
    test.assert_eq(back.deleted_parameters[0].value.integer_array_value[2], -8187533453093164668)
    test.assert_eq(back.deleted_parameters[0].value.integer_array_value[3], -9223371403024071020)
    test.assert_eq(back.deleted_parameters[0].value.double_array_value.len(), 4)
    test.assert(back.deleted_parameters[0].value.double_array_value[0] == -989.97592778335)
    test.assert(back.deleted_parameters[0].value.double_array_value[1] == 590.2527582748245)
    test.assert(back.deleted_parameters[0].value.double_array_value[2] == 703.1474423269809)
    test.assert(back.deleted_parameters[0].value.double_array_value[3] == -96.93179538615847)
    test.assert_eq(back.deleted_parameters[0].value.string_array_value.len(), 4)
    test.assert(back.deleted_parameters[0].value.string_array_value[0].eq_str("bravo_84/echo"))
    test.assert(back.deleted_parameters[0].value.string_array_value[1].eq_str("mike_85/papa"))
    test.assert(back.deleted_parameters[0].value.string_array_value[2].eq_str("lima_86/juliet"))
    test.assert(back.deleted_parameters[0].value.string_array_value[3].eq_str("oscar_87/bravo"))
    // They encode to the same bytes again.
    var w2 = writer_like(want)
    test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
    test.assert_eq_str(hex_of(w2), hex_of(w))
    // The other byte order decodes to the same message, which encodes to the first bytes.
    var wo = writer_unlike(want)
    test.assert_eq_str(cdr.status_name(m.encode(var wo)), "success")
    var ro = cdrbytes.reader_from_bytes(cdrbytes.to_bytes(wo))
    var other = rcl_interfaces.ParameterEvent.new()
    test.assert_eq_str(cdr.status_name(other.decode_into(var ro)), "success")
    var w3 = writer_like(want)
    test.assert_eq_str(cdr.status_name(other.encode(var w3)), "success")
    test.assert_eq_str(hex_of(w3), hex_of(w))

