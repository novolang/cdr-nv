fn test_vector_std_msgs_Int16MultiArray_full() [io, fs]
    let want = vector("std_msgs/msg/Int16MultiArray#full")
    var v_1: Vec[MultiArrayDimension; 16] = Vec.new()
    var s_2: String[64] = String.new()
    let _ = s_2.push_str("lima_1/oscar.juliet.juliet.juliet.juliet.juliet.juliet.juliet.ju")
    let _ = v_1.push(std_msgs.MultiArrayDimension {
            label: s_2,
            size: 4294967293 as u32,
            stride: 707888610 as u32 })
    var v_3: Vec[i16; 16] = Vec.new()
    let _ = v_3.push(31570 as i16)
    let _ = v_3.push(2540 as i16)
    let _ = v_3.push(93 as i16)
    let _ = v_3.push(10918 as i16)
    let _ = v_3.push(19933 as i16)
    let _ = v_3.push(25 as i16)
    let _ = v_3.push(17722 as i16)
    let _ = v_3.push((-12013) as i16)
    let _ = v_3.push(13 as i16)
    let _ = v_3.push((-8434) as i16)
    let _ = v_3.push((-27320) as i16)
    let _ = v_3.push((-29) as i16)
    let _ = v_3.push(19490 as i16)
    let _ = v_3.push((-26249) as i16)
    let _ = v_3.push((-1) as i16)
    let _ = v_3.push(8310 as i16)
    let m = std_msgs.Int16MultiArray {
        layout: std_msgs.MultiArrayLayout {
            dim: v_1,
            data_offset: 89 as u32 },
        data: v_3 }
    // The message built from the values encodes to the middleware's bytes.
    var w = writer_like(want)
    test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
    expect_bytes(hex_of(w), want)
    // The middleware's bytes decode to those values.
    var r = reader_of_hex(want)
    var back = std_msgs.Int16MultiArray.new()
    test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
    test.assert_eq(r.remaining(), (str.len(want) - str.len(hex_of(w))) / 2)
    test.assert_eq(back.layout.dim.len(), 1)
    test.assert(back.layout.dim[0].label.eq_str("lima_1/oscar.juliet.juliet.juliet.juliet.juliet.juliet.juliet.ju"))
    test.assert_eq(back.layout.dim[0].size as Int, 4294967293)
    test.assert_eq(back.layout.dim[0].stride as Int, 707888610)
    test.assert_eq(back.layout.data_offset as Int, 89)
    test.assert_eq(back.data.len(), 16)
    test.assert_eq(back.data[0] as Int, 31570)
    test.assert_eq(back.data[1] as Int, 2540)
    test.assert_eq(back.data[2] as Int, 93)
    test.assert_eq(back.data[3] as Int, 10918)
    test.assert_eq(back.data[4] as Int, 19933)
    test.assert_eq(back.data[5] as Int, 25)
    test.assert_eq(back.data[6] as Int, 17722)
    test.assert_eq(back.data[7] as Int, -12013)
    test.assert_eq(back.data[8] as Int, 13)
    test.assert_eq(back.data[9] as Int, -8434)
    test.assert_eq(back.data[10] as Int, -27320)
    test.assert_eq(back.data[11] as Int, -29)
    test.assert_eq(back.data[12] as Int, 19490)
    test.assert_eq(back.data[13] as Int, -26249)
    test.assert_eq(back.data[14] as Int, -1)
    test.assert_eq(back.data[15] as Int, 8310)
    // They encode to the same bytes again.
    var w2 = writer_like(want)
    test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
    test.assert_eq_str(hex_of(w2), hex_of(w))
    // The other byte order decodes to the same message, which encodes to the first bytes.
    var wo = writer_unlike(want)
    test.assert_eq_str(cdr.status_name(m.encode(var wo)), "success")
    var ro = cdrbytes.reader_from_bytes(cdrbytes.to_bytes(wo))
    var other = std_msgs.Int16MultiArray.new()
    test.assert_eq_str(cdr.status_name(other.decode_into(var ro)), "success")
    var w3 = writer_like(want)
    test.assert_eq_str(cdr.status_name(other.encode(var w3)), "success")
    test.assert_eq_str(hex_of(w3), hex_of(w))

