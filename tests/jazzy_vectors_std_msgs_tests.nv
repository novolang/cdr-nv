    expect_bytes(hex_of(w), want)
    // The middleware's bytes decode to those values.
    var r = reader_of_hex(want)
    var back = std_msgs.Byte.new()
    test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
    test.assert_eq(r.remaining(), (str.len(want) - str.len(hex_of(w))) / 2)
    test.assert_eq(back.data as Int, 80)
    // They encode to the same bytes again.
    var w2 = writer_like(want)
    test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
    test.assert_eq_str(hex_of(w2), hex_of(w))
    // The other byte order decodes to the same message, which encodes to the first bytes.
    var wo = writer_unlike(want)
    test.assert_eq_str(cdr.status_name(m.encode(var wo)), "success")
    var ro = cdrbytes.reader_from_bytes(cdrbytes.to_bytes(wo))
    var other = std_msgs.Byte.new()
    test.assert_eq_str(cdr.status_name(other.decode_into(var ro)), "success")
    var w3 = writer_like(want)
    test.assert_eq_str(cdr.status_name(other.encode(var w3)), "success")
    test.assert_eq_str(hex_of(w3), hex_of(w))

// std_msgs/msg/ByteMultiArray
@test
fn test_vector_std_msgs_ByteMultiArray() [io, fs]
    let want = vector("std_msgs/msg/ByteMultiArray")
    var v_1: Vec[MultiArrayDimension; 16] = Vec.new()
    var s_2: String[64] = String.new()
    let _ = s_2.push_str("juliet_1/alpha")
    let _ = v_1.push(std_msgs.MultiArrayDimension {
            label: s_2,
            size: 4294967295 as u32,
            stride: 3870962609 as u32 })
    var s_3: String[64] = String.new()
    let _ = s_3.push_str("golf_4/juliet")
    let _ = v_1.push(std_msgs.MultiArrayDimension {
            label: s_3,
            size: 1441289368 as u32,
            stride: 3352237933 as u32 })
    var v_4: Vec[u8; 16] = Vec.new()
    let _ = v_4.push(76 as u8)
    let _ = v_4.push(213 as u8)
    let _ = v_4.push(43 as u8)
    let m = std_msgs.ByteMultiArray {
        layout: std_msgs.MultiArrayLayout {
            dim: v_1,
            data_offset: 91 as u32 },
        data: v_4 }
    // The message built from the values encodes to the middleware's bytes.
    var w = writer_like(want)
    test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
    expect_bytes(hex_of(w), want)
    // The middleware's bytes decode to those values.
    var r = reader_of_hex(want)
    var back = std_msgs.ByteMultiArray.new()
    test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
    test.assert_eq(r.remaining(), (str.len(want) - str.len(hex_of(w))) / 2)
    test.assert_eq(back.layout.dim.len(), 2)
    test.assert(back.layout.dim[0].label.eq_str("juliet_1/alpha"))
    test.assert_eq(back.layout.dim[0].size as Int, 4294967295)
    test.assert_eq(back.layout.dim[0].stride as Int, 3870962609)
    test.assert(back.layout.dim[1].label.eq_str("golf_4/juliet"))
    test.assert_eq(back.layout.dim[1].size as Int, 1441289368)
    test.assert_eq(back.layout.dim[1].stride as Int, 3352237933)
    test.assert_eq(back.layout.data_offset as Int, 91)
    test.assert_eq(back.data.len(), 3)
    test.assert_eq(back.data[0] as Int, 76)
    test.assert_eq(back.data[1] as Int, 213)
    test.assert_eq(back.data[2] as Int, 43)
    // They encode to the same bytes again.
    var w2 = writer_like(want)
    test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
    test.assert_eq_str(hex_of(w2), hex_of(w))
    // The other byte order decodes to the same message, which encodes to the first bytes.
    var wo = writer_unlike(want)
    test.assert_eq_str(cdr.status_name(m.encode(var wo)), "success")
    var ro = cdrbytes.reader_from_bytes(cdrbytes.to_bytes(wo))
    var other = std_msgs.ByteMultiArray.new()
    test.assert_eq_str(cdr.status_name(other.decode_into(var ro)), "success")
    var w3 = writer_like(want)
    test.assert_eq_str(cdr.status_name(other.encode(var w3)), "success")
    test.assert_eq_str(hex_of(w3), hex_of(w))

// std_msgs/msg/ByteMultiArray#full
@test
fn test_vector_std_msgs_ByteMultiArray_full() [io, fs]
    let want = vector("std_msgs/msg/ByteMultiArray#full")
    var v_1: Vec[MultiArrayDimension; 16] = Vec.new()
    var s_2: String[64] = String.new()
    let _ = s_2.push_str("mike_1/charlie.lima.lima.lima.lima.lima.lima.lima.lima.lima.lima")
    let _ = v_1.push(std_msgs.MultiArrayDimension {
            label: s_2,
            size: 4294967293 as u32,
            stride: 4230434467 as u32 })
    var v_3: Vec[u8; 16] = Vec.new()
    let _ = v_3.push(79 as u8)
    let _ = v_3.push(102 as u8)
    let _ = v_3.push(58 as u8)
    let _ = v_3.push(243 as u8)
    let _ = v_3.push(28 as u8)
    let _ = v_3.push(86 as u8)
    let _ = v_3.push(215 as u8)
    let _ = v_3.push(78 as u8)
    let _ = v_3.push(74 as u8)
    let _ = v_3.push(251 as u8)
    let _ = v_3.push(240 as u8)
    let _ = v_3.push(94 as u8)
    let _ = v_3.push(95 as u8)
    let _ = v_3.push(19 as u8)
    let _ = v_3.push(30 as u8)
    let _ = v_3.push(3 as u8)
    let m = std_msgs.ByteMultiArray {
        layout: std_msgs.MultiArrayLayout {
            dim: v_1,
            data_offset: 26 as u32 },
        data: v_3 }
    // The message built from the values encodes to the middleware's bytes.
    var w = writer_like(want)
    test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
    expect_bytes(hex_of(w), want)
    // The middleware's bytes decode to those values.
    var r = reader_of_hex(want)
    var back = std_msgs.ByteMultiArray.new()
    test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
    test.assert_eq(r.remaining(), (str.len(want) - str.len(hex_of(w))) / 2)
    test.assert_eq(back.layout.dim.len(), 1)
    test.assert(back.layout.dim[0].label.eq_str("mike_1/charlie.lima.lima.lima.lima.lima.lima.lima.lima.lima.lima"))
    test.assert_eq(back.layout.dim[0].size as Int, 4294967293)
    test.assert_eq(back.layout.dim[0].stride as Int, 4230434467)
    test.assert_eq(back.layout.data_offset as Int, 26)
    test.assert_eq(back.data.len(), 16)
    test.assert_eq(back.data[0] as Int, 79)
    test.assert_eq(back.data[1] as Int, 102)
    test.assert_eq(back.data[2] as Int, 58)
    test.assert_eq(back.data[3] as Int, 243)
    test.assert_eq(back.data[4] as Int, 28)
    test.assert_eq(back.data[5] as Int, 86)
    test.assert_eq(back.data[6] as Int, 215)
    test.assert_eq(back.data[7] as Int, 78)
    test.assert_eq(back.data[8] as Int, 74)
    test.assert_eq(back.data[9] as Int, 251)
    test.assert_eq(back.data[10] as Int, 240)
    test.assert_eq(back.data[11] as Int, 94)
    test.assert_eq(back.data[12] as Int, 95)
    test.assert_eq(back.data[13] as Int, 19)
    test.assert_eq(back.data[14] as Int, 30)
    test.assert_eq(back.data[15] as Int, 3)
    // They encode to the same bytes again.
    var w2 = writer_like(want)
    test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
    test.assert_eq_str(hex_of(w2), hex_of(w))
    // The other byte order decodes to the same message, which encodes to the first bytes.
    var wo = writer_unlike(want)
    test.assert_eq_str(cdr.status_name(m.encode(var wo)), "success")
    var ro = cdrbytes.reader_from_bytes(cdrbytes.to_bytes(wo))
    var other = std_msgs.ByteMultiArray.new()
    test.assert_eq_str(cdr.status_name(other.decode_into(var ro)), "success")
    var w3 = writer_like(want)
    test.assert_eq_str(cdr.status_name(other.encode(var w3)), "success")
    test.assert_eq_str(hex_of(w3), hex_of(w))

