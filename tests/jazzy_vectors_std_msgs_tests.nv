// std_msgs/msg/UInt8MultiArray
@test
fn test_vector_std_msgs_UInt8MultiArray() [io, fs]
    let want = vector("std_msgs/msg/UInt8MultiArray")
    var v_1: Vec[MultiArrayDimension; 16] = Vec.new()
    var s_2: String[64] = String.new()
    let _ = s_2.push_str("hotel_1/delta")
    let _ = v_1.push(std_msgs.MultiArrayDimension {
            label: s_2,
            size: 4294967295 as u32,
            stride: 765882828 as u32 })
    var s_3: String[64] = String.new()
    let _ = s_3.push_str("mike_4/novembe")
    let _ = v_1.push(std_msgs.MultiArrayDimension {
            label: s_3,
            size: 639123630 as u32,
            stride: 1838167334 as u32 })
    var v_4: Vec[u8; 16] = Vec.new()
    let _ = v_4.push(194 as u8)
    let _ = v_4.push(82 as u8)
    let _ = v_4.push(89 as u8)
    let m = std_msgs.UInt8MultiArray {
        layout: std_msgs.MultiArrayLayout {
            dim: v_1,
            data_offset: 89 as u32 },
        data: v_4 }
    // The message built from the values encodes to the middleware's bytes.
