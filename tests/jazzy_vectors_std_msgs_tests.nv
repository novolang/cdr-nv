// std_msgs/msg/Float32MultiArray
@test
fn test_vector_std_msgs_Float32MultiArray() [io, fs]
    let want = vector("std_msgs/msg/Float32MultiArray")
    var v_1: Vec[MultiArrayDimension; 16] = Vec.new()
    var s_2: String[64] = String.new()
    let _ = s_2.push_str("oscar_1/echo")
    let _ = v_1.push(std_msgs.MultiArrayDimension {
            label: s_2,
            size: 4294967294 as u32,
            stride: 1625170064 as u32 })
    var s_3: String[64] = String.new()
    let _ = s_3.push_str("papa_4/kilo")
    let _ = v_1.push(std_msgs.MultiArrayDimension {
            label: s_3,
            size: 3657138057 as u32,
            stride: 1711494391 as u32 })
    var v_4: Vec[fp32; 16] = Vec.new()
    let _ = v_4.push(1713.671875 as fp32)
    let _ = v_4.push((-690.140625) as fp32)
    let _ = v_4.push(2581.578125 as fp32)
    let m = std_msgs.Float32MultiArray {
        layout: std_msgs.MultiArrayLayout {
            dim: v_1,
            data_offset: 12 as u32 },
        data: v_4 }
    // The message built from the values encodes to the middleware's bytes.
    var w = writer_like(want)
    test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
    expect_bytes(hex_of(w), want)
    // The middleware's bytes decode to those values.
    var r = reader_of_hex(want)
    var back = std_msgs.Float32MultiArray.new()
    test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
    test.assert_eq(r.remaining(), (str.len(want) - str.len(hex_of(w))) / 2)
    test.assert_eq(back.layout.dim.len(), 2)
    test.assert(back.layout.dim[0].label.eq_str("oscar_1/echo"))
    test.assert_eq(back.layout.dim[0].size as Int, 4294967294)
    test.assert_eq(back.layout.dim[0].stride as Int, 1625170064)
    test.assert(back.layout.dim[1].label.eq_str("papa_4/kilo"))
    test.assert_eq(back.layout.dim[1].size as Int, 3657138057)
    test.assert_eq(back.layout.dim[1].stride as Int, 1711494391)
    test.assert_eq(back.layout.data_offset as Int, 12)
    test.assert_eq(back.data.len(), 3)
    test.assert((back.data[0] as Float) == 1713.671875)
    test.assert((back.data[1] as Float) == -690.140625)
    test.assert((back.data[2] as Float) == 2581.578125)
    // They encode to the same bytes again.
    var w2 = writer_like(want)
    test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
    test.assert_eq_str(hex_of(w2), hex_of(w))
    // The other byte order decodes to the same message, which encodes to the first bytes.
    var wo = writer_unlike(want)
    test.assert_eq_str(cdr.status_name(m.encode(var wo)), "success")
    var ro = cdrbytes.reader_from_bytes(cdrbytes.to_bytes(wo))
    var other = std_msgs.Float32MultiArray.new()
    test.assert_eq_str(cdr.status_name(other.decode_into(var ro)), "success")
    var w3 = writer_like(want)
    test.assert_eq_str(cdr.status_name(other.encode(var w3)), "success")
    test.assert_eq_str(hex_of(w3), hex_of(w))

// std_msgs/msg/Float32MultiArray#full
@test
fn test_vector_std_msgs_Float32MultiArray_full() [io, fs]
    let want = vector("std_msgs/msg/Float32MultiArray#full")
