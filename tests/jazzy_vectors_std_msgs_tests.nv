    test.assert_eq(back.layout.dim.len(), 1)
    test.assert(back.layout.dim[0].label.eq_str("lima_1/bravo.charlie.charlie.charlie.charlie.charlie.charlie.cha"))
    test.assert_eq(back.layout.dim[0].size as Int, 4294967293)
    test.assert_eq(back.layout.dim[0].stride as Int, 454202699)
    test.assert_eq(back.layout.data_offset as Int, 13)
    test.assert_eq(back.data.len(), 16)
    test.assert_eq(back.data[0] as Int, 34)
    test.assert_eq(back.data[1] as Int, 40)
    test.assert_eq(back.data[2] as Int, -61)
    test.assert_eq(back.data[3] as Int, 118)
    test.assert_eq(back.data[4] as Int, -10)
    test.assert_eq(back.data[5] as Int, 25)
    test.assert_eq(back.data[6] as Int, 10)
    test.assert_eq(back.data[7] as Int, -76)
    test.assert_eq(back.data[8] as Int, -9)
    test.assert_eq(back.data[9] as Int, -34)
    test.assert_eq(back.data[10] as Int, -72)
    test.assert_eq(back.data[11] as Int, -53)
    test.assert_eq(back.data[12] as Int, -14)
    test.assert_eq(back.data[13] as Int, 117)
    test.assert_eq(back.data[14] as Int, 41)
    test.assert_eq(back.data[15] as Int, 70)
    // They encode to the same bytes again.
    var w2 = writer_like(want)
    test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
    test.assert_eq_str(hex_of(w2), hex_of(w))
