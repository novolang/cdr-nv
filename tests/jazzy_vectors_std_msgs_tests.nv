    var v_3: Vec[i8; 16] = Vec.new()
    let _ = v_3.push(34 as i8)
    let _ = v_3.push(40 as i8)
    let _ = v_3.push((-61) as i8)
    let _ = v_3.push(118 as i8)
    let _ = v_3.push((-10) as i8)
    let _ = v_3.push(25 as i8)
    let _ = v_3.push(10 as i8)
    let _ = v_3.push((-76) as i8)
    let _ = v_3.push((-9) as i8)
    let _ = v_3.push((-34) as i8)
    let _ = v_3.push((-72) as i8)
    let _ = v_3.push((-53) as i8)
    let _ = v_3.push((-14) as i8)
    let _ = v_3.push(117 as i8)
    let _ = v_3.push(41 as i8)
    let _ = v_3.push(70 as i8)
    let m = std_msgs.Int8MultiArray {
        layout: std_msgs.MultiArrayLayout {
            dim: v_1,
            data_offset: 13 as u32 },
        data: v_3 }
    // The message built from the values encodes to the middleware's bytes.
