// jazzy_vectors_sensor_msgs_tests.nv -- the messages of sensor_msgs as the ROS 2 middleware serialises them.
//
// Do not edit this file.  scripts/rclpy_vectors.py writes it, with tests/jazzy_vectors.tsv.
//
// Each test builds one message from literal values, encodes it and compares the bytes with
// the row of tests/jazzy_vectors.tsv that `rclpy.serialization.serialize_message` produced
// from the same values; decodes the middleware's bytes and checks every field; encodes the
// result again; and sends it through the other byte order and back.  The bytes Fast CDR
// skips to align a value are zero in the vector, because the middleware leaves them as its
// buffer held them; see the header of the TSV.

use std.bytes
use std.fs
use std.str
use std.test
use cdr
use cdrbytes
use builtin_interfaces
use geometry_msgs
use sensor_msgs
use std_msgs

// The hex of the row for `name`.
fn vector(name: Str) -> Str [fs]
    let text = fs.read("tests/jazzy_vectors.tsv") ?? ""
    for line in str.split(text, "\n")
        if not str.starts_with(line, "#")
            let cols = str.split(line, "\t")
            if list.len(cols) == 4 and cols[0] == name
                return cols[3]
    test.fail("no vector for ${name}")
    ""

// A writer in the byte order the vector's header names.
fn writer_like(hex: Str) -> cdr.Writer
    if str.starts_with(hex, "0000")
        cdr.writer_be()
    else
        cdr.writer_le()

// A writer in the other byte order.
fn writer_unlike(hex: Str) -> cdr.Writer
    if str.starts_with(hex, "0000")
        cdr.writer_le()
    else
        cdr.writer_be()

// The writer's bytes are the vector, or the vector without the zero bytes the middleware adds to
// bring a payload of fewer than four bytes up to four.
fn expect_bytes(got: Str, want: Str)
    test.assert(str.len(got) <= str.len(want))
    test.assert_eq_str(str.slice(want, 0, str.len(got)), got)
    let rest = str.slice(want, str.len(got), str.len(want))
    test.assert_eq_str(rest, str.repeat("0", str.len(rest)))
    if str.len(rest) > 0
        test.assert_eq(str.len(want), 16)

fn hex_of(w: cdr.Writer) -> Str
    bytes.to_hex(cdrbytes.to_bytes(w))

fn reader_of_hex(h: Str) -> cdr.Reader
    cdrbytes.reader_from_bytes(bytes.from_hex(h) ?? bytes.zeros(0))

// sensor_msgs/msg/Imu
@test
fn test_vector_sensor_msgs_Imu() [io, fs]
    let want = vector("sensor_msgs/msg/Imu")
    var s_1: String[64] = String.new()
    let _ = s_1.push_str("mike_4/echo")
    let m = sensor_msgs.Imu {
        header: std_msgs.Header {
            stamp: builtin_interfaces.Time {
                sec: 1229829482 as i32,
                nanosec: 57000227 as u32 },
            frame_id: s_1 },
        orientation: geometry_msgs.Quaternion {
            x: 717.5496489468405,
            y: -600.8595787362086,
            z: 560.1634904714142,
            w: -551.9578736208626 },
        orientation_covariance: [-677.5526579739218, 863.740220661986, 487.79739217652957, 273.0541624874624,
            556.3039117352056, 181.27983951855566, 476.3159478435306, 72.4332998996991,
            -260.75727181544636],
        angular_velocity: geometry_msgs.Vector3 {
            x: 243.50752256770312,
            y: 152.72617853560683,
            z: 374.86158475426276 },
        angular_velocity_covariance: [387.7863590772317, 901.1344032096289, 551.9087261785356, 186.93480441323973,
            996.8154463390171, -344.3961885656971, 441.2647943831494, -838.542627883651,
            -780.9327983951855],
        linear_acceleration: geometry_msgs.Vector3 {
            x: 383.7171514543631,
            y: 697.7993981945838,
            z: -871.7823470411233 },
        linear_acceleration_covariance: [135.555667001003, 821.5245737211635, -208.0270812437312, -27.254764292878637,
            -898.5095285857573, -144.70310932798395, -426.82547642928785, 572.4734202607823,
            -851.3279839518556] }
    // The message built from the values encodes to the middleware's bytes.
    var w = writer_like(want)
    test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
    expect_bytes(hex_of(w), want)
    // The middleware's bytes decode to those values.
    var r = reader_of_hex(want)
    var back = sensor_msgs.Imu.new()
    test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
    test.assert_eq(r.remaining(), (str.len(want) - str.len(hex_of(w))) / 2)
    test.assert_eq(back.header.stamp.sec as Int, 1229829482)
    test.assert_eq(back.header.stamp.nanosec as Int, 57000227)
    test.assert(back.header.frame_id.eq_str("mike_4/echo"))
    test.assert(back.orientation.x == 717.5496489468405)
    test.assert(back.orientation.y == -600.8595787362086)
    test.assert(back.orientation.z == 560.1634904714142)
    test.assert(back.orientation.w == -551.9578736208626)
    test.assert(back.orientation_covariance[0] == -677.5526579739218)
    test.assert(back.orientation_covariance[1] == 863.740220661986)
    test.assert(back.orientation_covariance[2] == 487.79739217652957)
    test.assert(back.orientation_covariance[3] == 273.0541624874624)
    test.assert(back.orientation_covariance[4] == 556.3039117352056)
    test.assert(back.orientation_covariance[5] == 181.27983951855566)
    test.assert(back.orientation_covariance[6] == 476.3159478435306)
    test.assert(back.orientation_covariance[7] == 72.4332998996991)
    test.assert(back.orientation_covariance[8] == -260.75727181544636)
    test.assert(back.angular_velocity.x == 243.50752256770312)
    test.assert(back.angular_velocity.y == 152.72617853560683)
    test.assert(back.angular_velocity.z == 374.86158475426276)
    test.assert(back.angular_velocity_covariance[0] == 387.7863590772317)
    test.assert(back.angular_velocity_covariance[1] == 901.1344032096289)
    test.assert(back.angular_velocity_covariance[2] == 551.9087261785356)
    test.assert(back.angular_velocity_covariance[3] == 186.93480441323973)
    test.assert(back.angular_velocity_covariance[4] == 996.8154463390171)
    test.assert(back.angular_velocity_covariance[5] == -344.3961885656971)
    test.assert(back.angular_velocity_covariance[6] == 441.2647943831494)
    test.assert(back.angular_velocity_covariance[7] == -838.542627883651)
    test.assert(back.angular_velocity_covariance[8] == -780.9327983951855)
    test.assert(back.linear_acceleration.x == 383.7171514543631)
    test.assert(back.linear_acceleration.y == 697.7993981945838)
    test.assert(back.linear_acceleration.z == -871.7823470411233)
    test.assert(back.linear_acceleration_covariance[0] == 135.555667001003)
    test.assert(back.linear_acceleration_covariance[1] == 821.5245737211635)
    test.assert(back.linear_acceleration_covariance[2] == -208.0270812437312)
    test.assert(back.linear_acceleration_covariance[3] == -27.254764292878637)
    test.assert(back.linear_acceleration_covariance[4] == -898.5095285857573)
    test.assert(back.linear_acceleration_covariance[5] == -144.70310932798395)
    test.assert(back.linear_acceleration_covariance[6] == -426.82547642928785)
    test.assert(back.linear_acceleration_covariance[7] == 572.4734202607823)
    test.assert(back.linear_acceleration_covariance[8] == -851.3279839518556)
    // They encode to the same bytes again.
    var w2 = writer_like(want)
    test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
    test.assert_eq_str(hex_of(w2), hex_of(w))
    // The other byte order decodes to the same message, which encodes to the first bytes.
    var wo = writer_unlike(want)
    test.assert_eq_str(cdr.status_name(m.encode(var wo)), "success")
    var ro = cdrbytes.reader_from_bytes(cdrbytes.to_bytes(wo))
    var other = sensor_msgs.Imu.new()
    test.assert_eq_str(cdr.status_name(other.decode_into(var ro)), "success")
    var w3 = writer_like(want)
    test.assert_eq_str(cdr.status_name(other.encode(var w3)), "success")
    test.assert_eq_str(hex_of(w3), hex_of(w))

// sensor_msgs/msg/Imu#full
@test
fn test_vector_sensor_msgs_Imu_full() [io, fs]
    let want = vector("sensor_msgs/msg/Imu#full")
    var s_1: String[64] = String.new()
    let _ = s_1.push_str("oscar_4/alpha.golf.golf.golf.golf.golf.golf.golf.golf.golf.golf.")
    let m = sensor_msgs.Imu {
        header: std_msgs.Header {
            stamp: builtin_interfaces.Time {
                sec: 1204336348 as i32,
                nanosec: 4158950197 as u32 },
            frame_id: s_1 },
        orientation: geometry_msgs.Quaternion {
            x: -573.81444332999,
            y: 47.61685055165496,
            z: 891.9739217652959,
            w: -829.3640922768305 },
        orientation_covariance: [-708.3179538615848, -945.9247743229689, 613.9959879638917, -883.7913741223671,
            -473.2507522567703, -888.0591775325978, 737.6890672016049, 560.7953861584755,
            499.8064192577733],
        angular_velocity: geometry_msgs.Vector3 {
            x: 833.9939819458375,
            y: 936.3069207622868,
            z: -342.5125376128385 },
        angular_velocity_covariance: [-818.3741223671013, 507.0361083249749, -423.96088264794383, -441.12136409227685,
            459.3119358074223, -323.1444332998997, -556.3069207622868, 225.6529588766299,
            243.52557673019058],
        linear_acceleration: geometry_msgs.Vector3 {
            x: -551.1644934804414,
            y: -689.6690070210632,
            z: -563.8826479438314 },
        linear_acceleration_covariance: [851.4192577733199, 504.3009027081244, 718.20962888666, 320.05717151454365,
            824.6459378134404, -732.3650952858576, -534.5325977933801, 262.45636910732196,
            853.9939819458375] }
    // The message built from the values encodes to the middleware's bytes.
    var w = writer_like(want)
    test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
    expect_bytes(hex_of(w), want)
    // The middleware's bytes decode to those values.
    var r = reader_of_hex(want)
    var back = sensor_msgs.Imu.new()
    test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
    test.assert_eq(r.remaining(), (str.len(want) - str.len(hex_of(w))) / 2)
    test.assert_eq(back.header.stamp.sec as Int, 1204336348)
    test.assert_eq(back.header.stamp.nanosec as Int, 4158950197)
    test.assert(back.header.frame_id.eq_str("oscar_4/alpha.golf.golf.golf.golf.golf.golf.golf.golf.golf.golf."))
    test.assert(back.orientation.x == -573.81444332999)
    test.assert(back.orientation.y == 47.61685055165496)
    test.assert(back.orientation.z == 891.9739217652959)
    test.assert(back.orientation.w == -829.3640922768305)
    test.assert(back.orientation_covariance[0] == -708.3179538615848)
    test.assert(back.orientation_covariance[1] == -945.9247743229689)
    test.assert(back.orientation_covariance[2] == 613.9959879638917)
    test.assert(back.orientation_covariance[3] == -883.7913741223671)
    test.assert(back.orientation_covariance[4] == -473.2507522567703)
    test.assert(back.orientation_covariance[5] == -888.0591775325978)
    test.assert(back.orientation_covariance[6] == 737.6890672016049)
    test.assert(back.orientation_covariance[7] == 560.7953861584755)
    test.assert(back.orientation_covariance[8] == 499.8064192577733)
    test.assert(back.angular_velocity.x == 833.9939819458375)
    test.assert(back.angular_velocity.y == 936.3069207622868)
    test.assert(back.angular_velocity.z == -342.5125376128385)
    test.assert(back.angular_velocity_covariance[0] == -818.3741223671013)
    test.assert(back.angular_velocity_covariance[1] == 507.0361083249749)
    test.assert(back.angular_velocity_covariance[2] == -423.96088264794383)
    test.assert(back.angular_velocity_covariance[3] == -441.12136409227685)
    test.assert(back.angular_velocity_covariance[4] == 459.3119358074223)
    test.assert(back.angular_velocity_covariance[5] == -323.1444332998997)
    test.assert(back.angular_velocity_covariance[6] == -556.3069207622868)
    test.assert(back.angular_velocity_covariance[7] == 225.6529588766299)
    test.assert(back.angular_velocity_covariance[8] == 243.52557673019058)
    test.assert(back.linear_acceleration.x == -551.1644934804414)
    test.assert(back.linear_acceleration.y == -689.6690070210632)
    test.assert(back.linear_acceleration.z == -563.8826479438314)
    test.assert(back.linear_acceleration_covariance[0] == 851.4192577733199)
    test.assert(back.linear_acceleration_covariance[1] == 504.3009027081244)
    test.assert(back.linear_acceleration_covariance[2] == 718.20962888666)
    test.assert(back.linear_acceleration_covariance[3] == 320.05717151454365)
    test.assert(back.linear_acceleration_covariance[4] == 824.6459378134404)
    test.assert(back.linear_acceleration_covariance[5] == -732.3650952858576)
    test.assert(back.linear_acceleration_covariance[6] == -534.5325977933801)
    test.assert(back.linear_acceleration_covariance[7] == 262.45636910732196)
    test.assert(back.linear_acceleration_covariance[8] == 853.9939819458375)
    // They encode to the same bytes again.
    var w2 = writer_like(want)
    test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
    test.assert_eq_str(hex_of(w2), hex_of(w))
    // The other byte order decodes to the same message, which encodes to the first bytes.
    var wo = writer_unlike(want)
    test.assert_eq_str(cdr.status_name(m.encode(var wo)), "success")
    var ro = cdrbytes.reader_from_bytes(cdrbytes.to_bytes(wo))
    var other = sensor_msgs.Imu.new()
    test.assert_eq_str(cdr.status_name(other.decode_into(var ro)), "success")
    var w3 = writer_like(want)
    test.assert_eq_str(cdr.status_name(other.encode(var w3)), "success")
    test.assert_eq_str(hex_of(w3), hex_of(w))

// sensor_msgs/msg/NavSatStatus
@test
fn test_vector_sensor_msgs_NavSatStatus() [io, fs]
    let want = vector("sensor_msgs/msg/NavSatStatus")
    let m = sensor_msgs.NavSatStatus {
        status: 83 as i8,
        service: 5708 as u16 }
    // The message built from the values encodes to the middleware's bytes.
    var w = writer_like(want)
    test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
    expect_bytes(hex_of(w), want)
    // The middleware's bytes decode to those values.
    var r = reader_of_hex(want)
    var back = sensor_msgs.NavSatStatus.new()
    test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
    test.assert_eq(r.remaining(), (str.len(want) - str.len(hex_of(w))) / 2)
    test.assert_eq(back.status as Int, 83)
    test.assert_eq(back.service as Int, 5708)
    // They encode to the same bytes again.
    var w2 = writer_like(want)
    test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
    test.assert_eq_str(hex_of(w2), hex_of(w))
    // The other byte order decodes to the same message, which encodes to the first bytes.
    var wo = writer_unlike(want)
    test.assert_eq_str(cdr.status_name(m.encode(var wo)), "success")
    var ro = cdrbytes.reader_from_bytes(cdrbytes.to_bytes(wo))
    var other = sensor_msgs.NavSatStatus.new()
    test.assert_eq_str(cdr.status_name(other.decode_into(var ro)), "success")
    var w3 = writer_like(want)
    test.assert_eq_str(cdr.status_name(other.encode(var w3)), "success")
    test.assert_eq_str(hex_of(w3), hex_of(w))

// sensor_msgs/msg/Temperature
@test
fn test_vector_sensor_msgs_Temperature() [io, fs]
    let want = vector("sensor_msgs/msg/Temperature")
    var s_1: String[64] = String.new()
    let _ = s_1.push_str("papa_4/charlie")
    let m = sensor_msgs.Temperature {
        header: std_msgs.Header {
            stamp: builtin_interfaces.Time {
                sec: 929096549 as i32,
                nanosec: 3518857307 as u32 },
            frame_id: s_1 },
        temperature: -782.5456369107322,
        variance: 689.9979939819458 }
    // The message built from the values encodes to the middleware's bytes.
    var w = writer_like(want)
    test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
    expect_bytes(hex_of(w), want)
    // The middleware's bytes decode to those values.
    var r = reader_of_hex(want)
    var back = sensor_msgs.Temperature.new()
    test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
    test.assert_eq(r.remaining(), (str.len(want) - str.len(hex_of(w))) / 2)
    test.assert_eq(back.header.stamp.sec as Int, 929096549)
    test.assert_eq(back.header.stamp.nanosec as Int, 3518857307)
    test.assert(back.header.frame_id.eq_str("papa_4/charlie"))
    test.assert(back.temperature == -782.5456369107322)
    test.assert(back.variance == 689.9979939819458)
    // They encode to the same bytes again.
    var w2 = writer_like(want)
    test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
    test.assert_eq_str(hex_of(w2), hex_of(w))
    // The other byte order decodes to the same message, which encodes to the first bytes.
    var wo = writer_unlike(want)
    test.assert_eq_str(cdr.status_name(m.encode(var wo)), "success")
    var ro = cdrbytes.reader_from_bytes(cdrbytes.to_bytes(wo))
    var other = sensor_msgs.Temperature.new()
    test.assert_eq_str(cdr.status_name(other.decode_into(var ro)), "success")
    var w3 = writer_like(want)
    test.assert_eq_str(cdr.status_name(other.encode(var w3)), "success")
    test.assert_eq_str(hex_of(w3), hex_of(w))

// sensor_msgs/msg/Temperature#full
@test
fn test_vector_sensor_msgs_Temperature_full() [io, fs]
    let want = vector("sensor_msgs/msg/Temperature#full")
    var s_1: String[64] = String.new()
    let _ = s_1.push_str("papa_4/juliet.golf.golf.golf.golf.golf.golf.golf.golf.golf.golf.")
    let m = sensor_msgs.Temperature {
        header: std_msgs.Header {
            stamp: builtin_interfaces.Time {
                sec: (-1311756427) as i32,
                nanosec: 1459245145 as u32 },
            frame_id: s_1 },
        temperature: -915.4543630892678,
        variance: -796.9789368104313 }
    // The message built from the values encodes to the middleware's bytes.
    var w = writer_like(want)
    test.assert_eq_str(cdr.status_name(m.encode(var w)), "success")
    expect_bytes(hex_of(w), want)
    // The middleware's bytes decode to those values.
    var r = reader_of_hex(want)
    var back = sensor_msgs.Temperature.new()
    test.assert_eq_str(cdr.status_name(back.decode_into(var r)), "success")
    test.assert_eq(r.remaining(), (str.len(want) - str.len(hex_of(w))) / 2)
    test.assert_eq(back.header.stamp.sec as Int, -1311756427)
    test.assert_eq(back.header.stamp.nanosec as Int, 1459245145)
    test.assert(back.header.frame_id.eq_str("papa_4/juliet.golf.golf.golf.golf.golf.golf.golf.golf.golf.golf."))
    test.assert(back.temperature == -915.4543630892678)
    test.assert(back.variance == -796.9789368104313)
    // They encode to the same bytes again.
    var w2 = writer_like(want)
    test.assert_eq_str(cdr.status_name(back.encode(var w2)), "success")
    test.assert_eq_str(hex_of(w2), hex_of(w))
    // The other byte order decodes to the same message, which encodes to the first bytes.
    var wo = writer_unlike(want)
    test.assert_eq_str(cdr.status_name(m.encode(var wo)), "success")
    var ro = cdrbytes.reader_from_bytes(cdrbytes.to_bytes(wo))
    var other = sensor_msgs.Temperature.new()
    test.assert_eq_str(cdr.status_name(other.decode_into(var ro)), "success")
    var w3 = writer_like(want)
    test.assert_eq_str(cdr.status_name(other.encode(var w3)), "success")
    test.assert_eq_str(hex_of(w3), hex_of(w))
